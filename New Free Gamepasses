-- DRAG
-- ============================================================
local function EnableDraggable(frame)
    local drag, dInput, dStart, sPos
    frame.InputBegan:Connect(function(i)
        if (i.UserInputType == Enum.UserInputType.MouseButton1
         or i.UserInputType == Enum.UserInputType.Touch) and not _G.LP10_Resizing then
            drag = true; dStart = i.Position; sPos = frame.Position
        end
    end)
    frame.InputChanged:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseMovement
        or i.UserInputType == Enum.UserInputType.Touch then dInput = i end
    end)
    UserInputService.InputChanged:Connect(function(i)
        if i == dInput and drag then
            local d = i.Position - dStart
            frame.Position = UDim2.new(sPos.X.Scale, sPos.X.Offset + d.X, sPos.Y.Scale, sPos.Y.Offset + d.Y)
        end
    end)
    frame.InputEnded:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1
        or i.UserInputType == Enum.UserInputType.Touch then drag = false end
    end)
end

-- ============================================================
-- RESIZE
-- ============================================================
local currentSize = Main.Size
RH.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
    or input.UserInputType == Enum.UserInputType.Touch then
        _G.LP10_Resizing = true
        local ds = input.Position
        local ss = Main.Size
        local conn
        conn = UserInputService.InputChanged:Connect(function(inp)
            if inp.UserInputType == Enum.UserInputType.MouseMovement
            or inp.UserInputType == Enum.UserInputType.Touch then
                local d = inp.Position - ds
                Main.Size = UDim2.new(0,
                    math.clamp(ss.X.Offset + d.X, Config.MinSize.X, Config.MaxSize.X), 0,
                    math.clamp(ss.Y.Offset + d.Y, Config.MinSize.Y, Config.MaxSize.Y)
                )
                currentSize = Main.Size
            end
        end)
        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                _G.LP10_Resizing = false
                conn:Disconnect()
            end
        end)
    end
end)

