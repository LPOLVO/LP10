-- FETCH GAME DATA
-- ============================================================
local function FetchGameData()
    table.clear(allProducts); table.clear(productNames)
    table.clear(allGamepasses); table.clear(gamepassNames)
    selectedProduct = nil; selectedGamepass = nil

    pcall(function()
        local ok, page = pcall(function()
            return MarketplaceService:GetDeveloperProductsAsync():GetCurrentPage()
        end)
        if ok and page then
            for _, v in ipairs(page) do
                table.insert(allProducts, {id = v.ProductId, name = v.Name})
                table.insert(productNames, v.Name)
            end
        end
    end)

    pcall(function()
        local uni = HttpService:JSONDecode(
            game:HttpGet("https://apis.roblox.com/universes/v1/places/"..game.PlaceId.."/universe")
        ).universeId
        local data = HttpService:JSONDecode(
            game:HttpGet("https://games.roblox.com/v1/games/"..uni.."/game-passes?limit=100")
        )
        for _, v in ipairs(data.data or {}) do
            allGamepasses[v.displayName] = v.id
            table.insert(gamepassNames, v.displayName)
        end
    end)
end

