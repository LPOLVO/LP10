local function MkSection(order, text)
    local l = Instance.new("TextLabel", Container)
    l.Size = UDim2.new(1, 0, 0, 20)
    l.BackgroundTransparency = 1
    l.Font = Enum.Font.GothamBold
    l.Text = "  " .. text
    l.TextColor3 = Config.Accent
    l.TextSize = 10
    l.TextXAlignment = Enum.TextXAlignment.Left
    l.LayoutOrder = order
    return l
end

local function MkBtn(order, text, bg, cb)
    local b = Instance.new("TextButton", Container)
    b.Size = UDim2.new(1, 0, 0, 32)
    b.BackgroundColor3 = bg or Config.CardBg
    b.Text = text
    b.TextColor3 = Color3.new(1,1,1)
    b.Font = Enum.Font.GothamBold
    b.TextSize = 11
    b.AutoButtonColor = false
    b.LayoutOrder = order
    Instance.new("UICorner", b).CornerRadius = UDim.new(0, 7)
    local s = Instance.new("UIStroke", b)
    s.Color = Config.Accent; s.Thickness = 1; s.Transparency = 0.6
    b.MouseEnter:Connect(function()
        TweenService:Create(b, TweenInfo.new(0.12), {BackgroundColor3 = Color3.fromRGB(28, 90, 165)}):Play()
    end)
    b.MouseLeave:Connect(function()
        TweenService:Create(b, TweenInfo.new(0.12), {BackgroundColor3 = bg or Config.CardBg}):Play()
    end)
    b.MouseButton1Click:Connect(function() if cb then pcall(cb) end end)
    return b
end

local function MkDropdown(order, title, list, cb)
    local open = false; local chosen = nil
    local wrap = Instance.new("Frame", Container)
    wrap.Size = UDim2.new(1, 0, 0, 32)
    wrap.BackgroundColor3 = Config.CardBg
    wrap.BorderSizePixel = 0
    wrap.ClipsDescendants = true
    wrap.LayoutOrder = order
    Instance.new("UICorner", wrap).CornerRadius = UDim.new(0, 7)
    local ws = Instance.new("UIStroke", wrap)
    ws.Color = Config.Accent; ws.Thickness = 1; ws.Transparency = 0.6

    local hdr = Instance.new("TextButton", wrap)
    hdr.Size = UDim2.new(1, 0, 0, 32)
    hdr.BackgroundTransparency = 1
    hdr.Font = Enum.Font.GothamBold
    hdr.Text = "v  " .. title
    hdr.TextColor3 = Config.Accent
    hdr.TextSize = 11
    hdr.TextXAlignment = Enum.TextXAlignment.Left
    hdr.ZIndex = 2
    local hp = Instance.new("UIPadding", hdr); hp.PaddingLeft = UDim.new(0, 8)

    local optF = Instance.new("Frame", wrap)
    optF.Position = UDim2.new(0, 0, 0, 32)
    optF.Size = UDim2.new(1, 0, 0, 0)
    optF.BackgroundTransparency = 1
    local oL = Instance.new("UIListLayout", optF)
    oL.SortOrder = Enum.SortOrder.LayoutOrder

    for i, item in ipairs(list) do
        local opt = Instance.new("TextButton", optF)
        opt.Size = UDim2.new(1, 0, 0, 26)
        opt.BackgroundTransparency = 1
        opt.Font = Enum.Font.Gotham
        opt.Text = "  " .. tostring(item)
        opt.TextColor3 = Color3.fromRGB(160, 195, 230)
        opt.TextSize = 10
        opt.TextXAlignment = Enum.TextXAlignment.Left
        opt.LayoutOrder = i
        opt.AutoButtonColor = false
        opt.MouseEnter:Connect(function() opt.TextColor3 = Config.Accent end)
        opt.MouseLeave:Connect(function() opt.TextColor3 = Color3.fromRGB(160, 195, 230) end)
        opt.MouseButton1Click:Connect(function()
            chosen = item
            hdr.Text = "OK  " .. tostring(item)
            if cb then pcall(cb, item) end
            open = false
            TweenService:Create(wrap, TweenInfo.new(0.18, Enum.EasingStyle.Quart), {
                Size = UDim2.new(1, 0, 0, 32)
            }):Play()
        end)
    end

    hdr.MouseButton1Click:Connect(function()
        open = not open
        local h = open and (32 + #list * 26 + 4) or 32
        hdr.Text = (open and "^  " or "v  ") .. (chosen or title)
        TweenService:Create(wrap, TweenInfo.new(0.2, Enum.EasingStyle.Quart), {
            Size = UDim2.new(1, 0, 0, h)
        }):Play()
    end)
    return wrap
end

