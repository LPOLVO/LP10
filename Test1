local isOpen = true  -- already visible on execute

CloseBtn.MouseButton1Click:Connect(function()
    isOpen = false
    Main:TweenSize(UDim2.new(0, 0, 0, 0), "In", "Back", 0.3, true, function()
        if not isOpen then Main.Visible = false end
    end)
end)

ToggleBtn.MouseButton1Click:Connect(function()
    isOpen = not isOpen
    if isOpen then
        Main.Visible = true
        Main:TweenSize(currentSize, "Out", "Back", 0.3, true)
    else
        Main:TweenSize(UDim2.new(0, 0, 0, 0), "In", "Back", 0.3, true, function()
            if not isOpen then Main.Visible = false end
        end)
    end
end)

-- RightShift keybind
UserInputService.InputBegan:Connect(function(inp, processed)
    if not processed and inp.KeyCode == Enum.KeyCode.RightShift then
        isOpen = not isOpen
        if isOpen then
            Main.Visible = true
            Main:TweenSize(currentSize, "Out", "Back", 0.3, true)
        else
            Main:TweenSize(UDim2.new(0, 0, 0, 0), "In", "Back", 0.3, true, function()
                if not isOpen then Main.Visible = false end
            end)
        end
    end
end)

