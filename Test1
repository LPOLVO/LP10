local function makeToggle(parent, label, key, yOff, desc)
    local row = new("Frame", {
        Size=UDim2.new(1,0,0,44), Position=UDim2.fromOffset(0,yOff),
        BackgroundColor3=C.card, ZIndex=3,
    }, parent)
    corner(10, row)

    new("TextLabel", {
        Size=UDim2.new(1,-60,0,18), Position=UDim2.fromOffset(12,6),
        Text=label, TextColor3=C.white,
        Font=Enum.Font.GothamSemibold, TextSize=11,
        BackgroundTransparency=1, TextXAlignment=Enum.TextXAlignment.Left, ZIndex=4,
    }, row)
    if desc then
        new("TextLabel", {
            Size=UDim2.new(1,-60,0,14), Position=UDim2.fromOffset(12,26),
            Text=desc, TextColor3=C.dim,
            Font=Enum.Font.Gotham, TextSize=8,
            BackgroundTransparency=1, TextXAlignment=Enum.TextXAlignment.Left, ZIndex=4,
        }, row)
    end

    local tog = new("TextButton", {
        Size=UDim2.fromOffset(46,24), Position=UDim2.new(1,-54,0,10),
        BackgroundColor3=Toggles[key] and C.accent or Color3.fromRGB(28,28,48),
        Text=Toggles[key] and "ON" or "OFF",
        TextColor3=C.white, Font=Enum.Font.GothamBold, TextSize=9, ZIndex=4,
    }, row)
    corner(12, tog)

    tog.MouseButton1Click:Connect(function()
        Toggles[key] = not Toggles[key]
        tog.BackgroundColor3 = Toggles[key] and C.accent or Color3.fromRGB(28,28,48)
        tog.Text = Toggles[key] and "ON" or "OFF"
        notify((Toggles[key] and "Enabled: " or "Disabled: ")..label)
    end)
    return row
end

