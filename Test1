local function httpGet(url)
    if syn and syn.request then
        local ok, r = pcall(syn.request, {Url=url, Method="GET"})
        if ok and r and r.StatusCode == 200 then return r.Body end
    end
    if request then
        local ok, r = pcall(request, {Url=url, Method="GET"})
        if ok and r and r.StatusCode == 200 then return r.Body end
    end
    if http_request then
        local ok, r = pcall(http_request, {Url=url, Method="GET"})
        if ok and r and r.StatusCode == 200 then return r.Body end
    end
    local ok, r = pcall(function() return game:HttpGet(url) end)
    if ok and r and r ~= "" then return r end
    return nil
end

local function safeSetClipboard(text)
    if setclipboard then pcall(setclipboard, text)
    elseif toclipboard then pcall(toclipboard, text)
    elseif rbxSetClipboard then pcall(rbxSetClipboard, text) end
end

local function safeGetConnections(signal)
    if getconnections then
        local ok, c = pcall(getconnections, signal)
        if ok then return c end
    end
    return {}
end

local _fireprox = fireproximityprompt or function(p)
