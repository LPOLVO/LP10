local activeTab = nil

local function makeTab(name, order)
    local btn = Instance.new("TextButton", TabBar)
    btn.Size               = UDim2.new(0, 70, 1, 0)
    btn.BackgroundColor3   = Color3.fromRGB(14, 18, 40)
    btn.BorderSizePixel    = 0
    btn.Font               = Enum.Font.GothamBold
    btn.TextSize           = 11
    btn.TextColor3         = Color3.fromRGB(120, 140, 180)
    btn.Text               = name
    btn.AutoButtonColor    = false
    btn.ZIndex             = 12
    btn.LayoutOrder        = order
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 7)

    local page = Instance.new("Frame", ScrollArea)
    page.Size              = UDim2.new(1, 0, 0, 0)
    page.AutomaticSize     = Enum.AutomaticSize.Y
    page.BackgroundTransparency = 1
    page.Visible           = false
    page.BorderSizePixel   = 0
    page.ZIndex            = 12
    local pl = Instance.new("UIListLayout", page)
    pl.SortOrder  = Enum.SortOrder.LayoutOrder
    pl.Padding    = UDim.new(0, 3)
    local pp = Instance.new("UIPadding", page)
    pp.PaddingBottom = UDim.new(0, 6)

    tabPages[name] = page
    tabBtns[name]  = btn

    btn.MouseButton1Click:Connect(function()
        if activeTab and tabPages[activeTab] then
            tabPages[activeTab].Visible = false
            TweenService:Create(tabBtns[activeTab], TweenInfo.new(0.12), {BackgroundColor3 = Color3.fromRGB(14,18,40), TextColor3 = Color3.fromRGB(120,140,180)}):Play()
        end
        activeTab = name
        page.Visible = true
        TweenService:Create(btn, TweenInfo.new(0.12), {BackgroundColor3 = AccentColor, TextColor3 = Color3.fromRGB(255,255,255)}):Play()
        ScrollArea.CanvasPosition = Vector2.new(0, 0)
    end)
    return page
end

