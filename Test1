local tabs = {}
local tabPages = {}
local activeTab = nil

local function makeTab(name)
    local tabBtn = Instance.new("TextButton", TabBar)
    tabBtn.Size = UDim2.new(0, 80, 1, 0)
    tabBtn.BackgroundColor3 = Color3.fromRGB(18, 24, 48)
    tabBtn.BorderSizePixel = 0
    tabBtn.Font = Enum.Font.GothamBold
    tabBtn.TextSize = 11
    tabBtn.TextColor3 = TEXT_DIM
    tabBtn.Text = name
    tabBtn.AutoButtonColor = false
    tabBtn.ZIndex = 12
    Instance.new("UICorner", tabBtn).CornerRadius = UDim.new(0, 8)

    -- page inside content area
    local page = Instance.new("Frame", ContentArea)
    page.Size = UDim2.new(1, 0, 0, 0)
    page.AutomaticSize = Enum.AutomaticSize.Y
    page.BackgroundTransparency = 1
    page.Visible = false
    page.BorderSizePixel = 0
    page.ZIndex = 12
    local pageLayout = Instance.new("UIListLayout", page)
    pageLayout.SortOrder = Enum.SortOrder.LayoutOrder
    pageLayout.Padding = UDim.new(0, 6)
    local pagePad = Instance.new("UIPadding", page)
    pagePad.PaddingBottom = UDim.new(0, 10)

    tabs[name] = {btn = tabBtn, page = page}

    tabBtn.MouseButton1Click:Connect(function()
        if activeTab then
            local old = tabs[activeTab]
            old.page.Visible = false
            TweenService:Create(old.btn, TweenInfo.new(0.15), {BackgroundColor3 = Color3.fromRGB(18,24,48), TextColor3 = TEXT_DIM}):Play()
        end
        activeTab = name
        page.Visible = true
        TweenService:Create(tabBtn, TweenInfo.new(0.15), {BackgroundColor3 = ACCENT, TextColor3 = Color3.fromRGB(255,255,255)}):Play()
    end)

    return page
end

