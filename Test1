    local dLayout = Instance.new("UIListLayout", dScroll)
    dLayout.SortOrder = Enum.SortOrder.LayoutOrder
    dLayout.Padding = UDim.new(0, 1)

    local isOpen = false
    local function closeDropdown()
        isOpen = false
        TweenService:Create(dropFrame, TweenInfo.new(0.15), {Size = UDim2.new(0, dropFrame.Size.X.Offset, 0, 0)}):Play()
        task.delay(0.16, function() dropFrame.Visible = false end)
    end

    local optBtns = {}
    for _, v in ipairs(values or {}) do
        local opt = Instance.new("TextButton", dScroll)
        opt.Size = UDim2.new(1, 0, 0, 28)
        opt.BackgroundColor3 = Color3.fromRGB(14, 18, 36)
        opt.BorderSizePixel = 0
        opt.Font = Enum.Font.Gotham
        opt.TextSize = 11
        opt.TextColor3 = TEXT_W
        opt.Text = v
        opt.ZIndex = 302
        opt.AutoButtonColor = false
        Instance.new("UICorner", opt).CornerRadius = UDim.new(0, 0)
        opt.MouseButton1Click:Connect(function()
            curVal = v
            selBtn.Text = v
            closeDropdown()
            if callback then callback(v) end
        end)
        optBtns[#optBtns+1] = opt
    end

    selBtn.MouseButton1Click:Connect(function()
        if isOpen then closeDropdown(); return end
        isOpen = true
        -- position below the selBtn in screen space
        local absPos = selBtn.AbsolutePosition
        local absSize = selBtn.AbsoluteSize
        local w = math.max(absSize.X, 180)
        local maxH = math.min(200, #(values or {}) * 29 + 4)
        dropFrame.Position = UDim2.new(0, absPos.X, 0, absPos.Y + absSize.Y + 4)
        dropFrame.Size = UDim2.new(0, w, 0, 0)
        dropFrame.Visible = true
        TweenService:Create(dropFrame, TweenInfo.new(0.18, Enum.EasingStyle.Quad), {Size = UDim2.new(0, w, 0, maxH)}):Play()
    end)

    return row, function() return curVal end, function(v) curVal = v; selBtn.Text = v end
end

