-- ════════════ LOGIC ════════════
local function doBuySeeds()
    if not SeedConveyorService or not SeedConfig then return end
    if not hasInventorySpace() then return end
    local field = workspace:FindFirstChild("BigField")
    local folder = field and field:FindFirstChild("ConveyorSeeds")
    if not folder then return end
    for _, holder in ipairs(folder:GetChildren()) do
        local spawnId  = holder:GetAttribute("SpawnId")
        local seedType = holder:GetAttribute("SeedType")
        local rarity   = holder:GetAttribute("Rarity")
        if spawnId and seedType and rarity and not purchasedSpawns[spawnId] then
            if not Toggles.AutoBuySeeds then return end
            local seed = SeedConfig.GetSeed(seedType)
            local cost = seed and seed.plantCost or 0
            if Options.BuyMaxCost > 0 and cost > Options.BuyMaxCost then goto continue end
            if getCoins() - cost < Options.BuyReserve then goto continue end
            local ok, success = pcall(function()
                return SeedConveyorService:RequestPurchase(spawnId):await()
            end)
            if ok and success then
                purchasedSpawns[spawnId] = true
                if not hasInventorySpace() then return end
            end
            task.wait(0.2)
        end
        ::continue::
    end
    -- cleanup
    for spawnId in pairs(purchasedSpawns) do
        local still = false
        for _, h in ipairs(folder:GetChildren()) do
            if h:GetAttribute("SpawnId") == spawnId then still = true; break end
        end
        if not still then purchasedSpawns[spawnId] = nil end
    end
end

local function refreshRound()
    if not PlantRoundService then return end
    local ok, rounds = pcall(function() return PlantRoundService:GetActiveRounds():await() end)
    if not ok or type(rounds) ~= "table" then return end
    for _, round in pairs(rounds) do
        if round.userId == LocalPlayer.UserId then activeRound = round; return end
    end
    activeRound = nil
end

local function roundMultiplier(startTime)
    local elapsed = math.max(0, workspace:GetServerTimeNow() - startTime)
    return math.max(0, math.floor((math.exp(elapsed * 0.28) - 1) * 100) / 100)
end

local function doRoundHarvest()
    local round = activeRound
    if not round then return end
    if round.crashed then
        if Toggles.AutoCollectDead and harvestedRoundId ~= round.roundId then
            harvestedRoundId = round.roundId
            pcall(function() PlantRoundService:CollectDeadTree():await() end)
        end
        return
    end
    if round.stopped or harvestedRoundId == round.roundId or not Toggles.AutoHarvest then return end
    local mult = roundMultiplier(round.startTime)
    if mult < Options.HarvestMultiplier then return end
    harvestedRoundId = round.roundId
    local ok = pcall(function() PlantRoundService:StopPlant():await() end)
end

local function findPlantableSlot()
    local data = getData()
    if not data or not data.Inventory then return nil end
    for _, container in ipairs({{data.Inventory.Hotbar, true}, {data.Inventory.Storage, false}}) do
        local items, isHotbar = container[1], container[2]
        for slot, item in pairs(items or {}) do
            if item and item.itemType == "Seed" and item.seedType then
                return slot, isHotbar
            end
        end
    end
    return nil
end

local function getEquippedSeedTool()
    local char = LocalPlayer.Character
    if not char then return nil end
    for _, t in ipairs(char:GetChildren()) do
        if t:IsA("Tool") and t:GetAttribute("IsSeed") then return t end
    end
    return nil
end

local function doPlant()
    if not PlantRoundService or not ToolService then return end
    if activeRound and not activeRound.stopped and not activeRound.crashed then return end
    local tool = getEquippedSeedTool()
    if not tool then
        local slot, isHotbar = findPlantableSlot()
        if not slot then return end
        pcall(function() ToolService.ToggleEquip:Fire(isHotbar, slot) end)
        local deadline = tick() + 3
        repeat task.wait(0.1); tool = getEquippedSeedTool() until tool or tick() > deadline
    end
    if not tool then return end
    local seedType = tool:GetAttribute("SeedType")
    if not seedType then return end
    pcall(function()
        local ok, started = PlantRoundService:StartRound(seedType, "None"):await()
        if ok and started then harvestedRoundId = nil; pcall(refreshRound) end
    end)
end

local function doHarvest()
    local plot = getMyPlot()
    if not plot or not PlayerPlotService then return end
    if Toggles.HarvestTeleport == false then
        pcall(function() PlayerPlotService:CollectAllFruits():await() end)
        return
    end
    local root = getRoot()
    local returnCF = root and root.CFrame
    for _, tree in ipairs(plot:GetChildren()) do
        if tree.Name:match("^PlotTree_") then
            if Toggles.HarvestTeleport and root then
                local base = tree:FindFirstChild("Base")
                if base then root.CFrame = base.CFrame + Vector3.new(0,5,0); task.wait(0.1) end
            end
            for _, desc in ipairs(tree:GetDescendants()) do
                if desc:IsA("ProximityPrompt") then
                    local parent = desc.Parent
                    while parent and parent ~= tree do
                        if parent.Name == "FruitSpawns" then
                            if not Toggles.AutoCollectFruit then break end
                            pcall(_fireprox, desc)
                            task.wait(0.1)
                            break
                        end
                        parent = parent.Parent
                    end
                end
            end
        end
    end
    if Toggles.HarvestTeleport and root and returnCF then root.CFrame = returnCF end
end

local function countFruitTools()
    local count = 0
    local char = LocalPlayer.Character
    local bp   = LocalPlayer:FindFirstChild("Backpack")
    for _, c in ipairs({char, bp}) do
        if c then
            for _, t in ipairs(c:GetChildren()) do
                if t:IsA("Tool") and t:GetAttribute("IsFruit") then count += 1 end
            end
        end
    end
    return count
end

local function doSellFruits()
    if not SellFruitsService then return end
    local char = LocalPlayer.Character
    local hum  = char and char:FindFirstChildOfClass("Humanoid")
    local bp   = LocalPlayer:FindFirstChild("Backpack")
    if not hum or not bp then return end
    if countFruitTools() < Options.SellMinFruits then return end
    while running and Toggles.AutoSellFruits do
        local fruit
        for _, t in ipairs(char:GetChildren()) do
            if t:IsA("Tool") and t:GetAttribute("IsFruit") then fruit = t; break end
        end
        if not fruit then
            for _, t in ipairs(bp:GetChildren()) do
                if t:IsA("Tool") and t:GetAttribute("IsFruit") then
                    pcall(function() hum:EquipTool(t) end); fruit = t; break
                end
            end
        end
        if not fruit then break end
        pcall(function() SellFruitsService:SellFruit():await() end)
        task.wait(0.2)
    end
end

local function doSellAll()
    if SellStandService then pcall(function() SellStandService:SellAll():await() end) end
end

local function doRebirth()
    if not RebirthService or not RebirthConfig then return end
    local data = getData()
    if not data then return end
    local current = data.Rebirth or 0
    if current >= (Options.RebirthMaxLevel or RebirthConfig.MaxLevel) then return end
    local nextR = RebirthConfig.GetNext(current)
    if not nextR or getCoins() < nextR.cost then return end
    pcall(function() RebirthService:DoRebirth():await() end)
end

