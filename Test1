-- ═══ TAB SYSTEM ═══
local currentTab = nil
local tabButtons = {}

local tabDefs = {
    {name="Farm",  fn=buildFarmTab},
    {name="Seeds", fn=buildSeedsTab},
    {name="Info",  fn=buildInfoTab},
}

local function switchTab(name, fn)
    if currentTab == name then return end
    currentTab = name
    for tname, btn in pairs(tabButtons) do
        btn.BackgroundColor3 = tname == name and C.accent or C.card
        btn.TextColor3       = tname == name and C.white or C.dim
    end
    fn()
end

for i, def in ipairs(tabDefs) do
    local btn = new("TextButton", {
        Size=UDim2.new(0,1,1,0),
        BackgroundColor3 = i==1 and C.accent or C.card,
        Text = def.name,
        TextColor3 = i==1 and C.white or C.dim,
        Font = Enum.Font.GothamBold,
        TextSize = 10,
        ZIndex = 3,
        LayoutOrder = i,
    }, TabBar)
    corner(8, btn)
    tabButtons[def.name] = btn

    local capDef = def
    btn.MouseButton1Click:Connect(function()
        switchTab(capDef.name, capDef.fn)
    end)
end

-- Auto-size tab buttons equally
task.defer(function()
    local totalW = TabBar.AbsoluteSize.X
    local btnW   = math.floor((totalW - (#tabDefs-1)*6) / #tabDefs)
    for _, btn in pairs(tabButtons) do
        btn.Size = UDim2.fromOffset(btnW, 30)
    end
end)

