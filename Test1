    track.BorderSizePixel  = 0
    track.ZIndex           = 13
    Instance.new("UICorner", track).CornerRadius = UDim.new(1, 0)
    local fill = Instance.new("Frame", track)
    fill.BackgroundColor3  = AccentColor
    fill.BorderSizePixel   = 0
    fill.ZIndex            = 14
    Instance.new("UICorner", fill).CornerRadius = UDim.new(1, 0)
    local knob = Instance.new("Frame", track)
    knob.Size              = UDim2.new(0, 12, 0, 12)
    knob.AnchorPoint       = Vector2.new(0.5, 0.5)
    knob.BackgroundColor3  = Color3.fromRGB(255, 255, 255)
    knob.BorderSizePixel   = 0
    knob.ZIndex            = 15
    Instance.new("UICorner", knob).CornerRadius = UDim.new(1, 0)

    local mult = 10^(rounding or 1)
    local function setVal(v)
        v = math.clamp(v, min, max)
        v = math.round(v * mult) / mult
        if Options[optKey] then Options[optKey].Value = v end
        local pct = (v - min) / (max - min)
        fill.Size     = UDim2.new(pct, 0, 1, 0)
        knob.Position = UDim2.new(pct, 0, 0.5, 0)
        valLbl.Text   = tostring(v)
    end
    setVal(Options[optKey] and Options[optKey].Value or min)

    local dragging = false
    local function startDrag() dragging = true end
    track.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then startDrag() end
    end)
    knob.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then startDrag() end
    end)
    UserInputService.InputChanged:Connect(function(i)
        if dragging and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
            local pos = track.AbsolutePosition
            local sz  = track.AbsoluteSize
            local pct = math.clamp((i.Position.X - pos.X) / sz.X, 0, 1)
            setVal(min + (max - min) * pct)
        end
    end)
    UserInputService.InputEnded:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)
    return r
end

