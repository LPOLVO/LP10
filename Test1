task.spawn(function()
    while running do
        task.wait(2)
        if Toggles.AntiAfk then
            local idle     = tick() - antiAfkLastInput
            local sinceTap = tick() - antiAfkLastTap
            local camera   = workspace.CurrentCamera
            if camera and idle >= 300 and sinceTap >= 60 then
                local ok_vu2, vu = pcall(function() return game:GetService("VirtualUser") end)
                if ok_vu2 and vu then
                    pcall(function() vu:Button2Down(Vector2.new(0,0), camera.CFrame) end)
                    task.wait(0.1)
                    pcall(function() vu:Button2Up(Vector2.new(0,0),   camera.CFrame) end)
                    antiAfkLastTap = tick()
                end
            end
        end
    end
end)

