    local function RemoveEntry(id)
        for i, e in ipairs(Rec.Log) do
            if e.id == id then table.remove(Rec.Log, i) break end
        end
        Rec.Loops[id] = nil
        if Rec.Rows[id] then Rec.Rows[id]:Destroy() Rec.Rows[id] = nil end
        RefreshStatus()
    end

    local function AddEntry(e)
        e.id = Rec.NextId
        Rec.NextId += 1
        e.t = os.clock() - Rec.Start
        e.pos = e.pos or MyPos()
        table.insert(Rec.Log, e)
        if #Rec.Log > MAX_ENTRIES then
            local old = table.remove(Rec.Log, 1)
            Rec.Loops[old.id] = nil
            if Rec.Rows[old.id] then Rec.Rows[old.id]:Destroy() Rec.Rows[old.id] = nil end
        end
        AddRow(e)
        RefreshStatus()
        return e
    end

    local function NoisyCheck(key)
        local now = os.clock()
        local r = Rec.Rate[key]
        if not r or now - r.t0 > 1 then
            r = {t0 = now, n = 0}
            Rec.Rate[key] = r
        end
        r.n += 1
        if r.n > NOISE_LIMIT then
            Rec.Muted[key] = true
            return true
        end
        return false
    end

    ------------------------------------------------------------
    -- RECORDING SOURCES
    ------------------------------------------------------------
    local REMOTE_CLASSES = {RemoteEvent = true, RemoteFunction = true, UnreliableRemoteEvent = true}

    local function OnRemote(remote, method, args)
        if not Rec.Recording or not Rec.Alive then return end
        if os.clock() < Rec.SuppressUntil then return end
        local key = remote.Name
        if Rec.Muted[key] then return end
        if NoisyCheck(key) then
            AddEntry({kind = "info", title = "Auto-muted noisy remote", sub = key})
            return
        end
        local ok, e = pcall(function()
            return {
                kind = "remote", title = remote.Name .. ":" .. method,
                sub = SerArgs(args), inst = remote, method = method, args = args,
                key = key, path = DotPath(remote), luaPath = PathOf(remote),
            }
        end)
        if ok then AddEntry(e) end
    end

    local function InstallHook()
        genv.__LP10_REC_HANDLER = OnRemote
        if genv.__LP10_REC_HOOKED then Rec.HookOK = true return end

        if hookmetamethod and getnamecallmethod and newcclosure then
            local ok = pcall(function()
                local old
                old = hookmetamethod(game, "__namecall", newcclosure(function(self, ...)
                    local method = getnamecallmethod()
                    if method == "FireServer" or method == "InvokeServer" then
                        local handler = genv.__LP10_REC_HANDLER
                        if handler and not (checkcaller and checkcaller()) then
                            local _, cn = pcall(function() return self.ClassName end)
                            if REMOTE_CLASSES[cn] then
                                task.defer(handler, self, method, table.pack(...))
                            end
                        end
                    end
                    if setnamecallmethod and method then setnamecallmethod(method) end
                    return old(self, ...)
                end))
            end)
            if ok then genv.__LP10_REC_HOOKED = true Rec.HookOK = true return end
        end

        if hookfunction and newcclosure then
            local ok = pcall(function()
                local function HookMethod(inst, name, method)
                    local old
                    old = hookfunction(inst[name], newcclosure(function(self, ...)
                        local handler = genv.__LP10_REC_HANDLER
                        if handler and not (checkcaller and checkcaller()) then
                            task.defer(handler, self, method, table.pack(...))
                        end
                        return old(self, ...)
                    end))
                end
                HookMethod(Instance.new("RemoteEvent"), "FireServer", "FireServer")
                HookMethod(Instance.new("RemoteFunction"), "InvokeServer", "InvokeServer")
            end)
            if ok then genv.__LP10_REC_HOOKED = true Rec.HookOK = true return end
        end
        Rec.HookOK = false
    end

    local function HookGame()
        -- ProximityPrompts (most "collect" buttons)
        Track(PPS.PromptTriggered:Connect(function(prompt, plr)
            if not Rec.Recording or plr ~= LocalPlayer then return end
            local act, obj = prompt.ActionText, prompt.ObjectText
            AddEntry({
                kind = "prompt",
                title = "Prompt: " .. (act ~= "" and act or "Interact") .. (obj ~= "" and (" · " .. obj) or ""),
                sub = DotPath(prompt), inst = prompt, tpos = InstPos(prompt), luaPath = PathOf(prompt),
            })
        end))

        -- ClickDetectors
        local function WatchClick(cd)
            Track(cd.MouseClick:Connect(function(plr)
                if not Rec.Recording or plr ~= LocalPlayer then return end
                AddEntry({
                    kind = "click", title = "Click: " .. (cd.Parent and cd.Parent.Name or cd.Name),
                    sub = DotPath(cd), inst = cd, tpos = InstPos(cd), luaPath = PathOf(cd),
                })
            end))
        end
        task.spawn(function()
            local n = 0
            for _, d in ipairs(workspace:GetDescendants()) do
                if not Rec.Alive then return end
                if d:IsA("ClickDetector") then WatchClick(d) end
                n += 1
                if n % 400 == 0 then task.wait() end
            end
        end)
        Track(workspace.DescendantAdded:Connect(function(d)
            if d:IsA("ClickDetector") then WatchClick(d) end
        end))

        -- Tools (got / lost / dropped)
        local owned = setmetatable({}, {__mode = "k"})
        local function OnAdded(child)
            if not child:IsA("Tool") or owned[child] then return end
            owned[child] = true
            if Rec.Recording then
                AddEntry({kind = "tool", title = "TOOL+ " .. child.Name, sub = "added to inventory"})
            end
        end
        local function OnRemoved(child)
            if not child:IsA("Tool") then return end
            task.delay(0.4, function()
                if not owned[child] then return end
                local bp, ch = LocalPlayer:FindFirstChildOfClass("Backpack"), LocalPlayer.Character
                if child.Parent ~= bp and child.Parent ~= ch then
                    owned[child] = nil
                    if Rec.Recording then
                        AddEntry({kind = "tool", title = "TOOL- " .. child.Name, sub = "removed / dropped / sold"})
                    end
                end
            end)
        end
        local function Attach(container)
            if not container then return end
            for _, c in ipairs(container:GetChildren()) do
                if c:IsA("Tool") then owned[c] = true end
            end
            Track(container.ChildAdded:Connect(OnAdded))
            Track(container.ChildRemoved:Connect(OnRemoved))
        end
        task.spawn(function()
            Attach(LocalPlayer:WaitForChild("Backpack", 5))
            Attach(LocalPlayer.Character)
        end)
        Track(LocalPlayer.CharacterAdded:Connect(function(ch)
            task.wait(0.5)
            Attach(ch)
            Attach(LocalPlayer:FindFirstChildOfClass("Backpack"))
        end))

        -- leaderstats changes (shows the EFFECT of an action)
        local function WatchStat(v)
            if not v:IsA("ValueBase") then return end
            local last = v.Value
            Track(v.Changed:Connect(function(new)
                local prev = last
                last = new
                local key = "stat:" .. v.Name
                if not Rec.Recording or Rec.Muted[key] or NoisyCheck(key) then return end
                local delta = ""
                if type(new) == "number" and type(prev) == "number" then
                    delta = (" (%+g)"):format(new - prev)
                end
                AddEntry({kind = "stat", title = "STAT " .. v.Name .. delta, sub = tostring(prev) .. " → " .. tostring(new)})
            end))
        end
        task.spawn(function()
            local ls = LocalPlayer:WaitForChild("leaderstats", 8)
            if ls then
                for _, v in ipairs(ls:GetChildren()) do WatchStat(v) end
                Track(ls.ChildAdded:Connect(WatchStat))
            end
        end)
    end

    ------------------------------------------------------------
    -- REPLAY
    ------------------------------------------------------------
    local function RunEntry(e)
        Rec.SuppressUntil = os.clock() + 0.15
        if e.kind == "waypoint" then
            TpTo(e.pos, 0)
            return true
        elseif e.kind == "remote" then
            local r = e.inst
            if not (r and r.Parent) then return false end
            if Rec.TpFirst and e.pos then TpTo(e.pos, 0) task.wait(0.15) end
            local a = e.args or {n = 0}
            if e.method == "InvokeServer" then
                task.spawn(function() pcall(r.InvokeServer, r, unpack(a, 1, a.n)) end)
            else
                pcall(r.FireServer, r, unpack(a, 1, a.n))
            end
            return true
        elseif e.kind == "prompt" then
            local p = e.inst
            if not (p and p.Parent) then return false end
            if Rec.TpFirst then
                if e.pos then TpTo(e.pos, 0) elseif e.tpos then TpTo(e.tpos, 3) end
                task.wait(0.15)
            end
            if fireproximityprompt then
                pcall(fireproximityprompt, p)
            else
                pcall(function() p:InputHoldBegin() task.wait() p:InputHoldEnd() end)
            end
            return true
        elseif e.kind == "click" then
            if not (e.inst and e.inst.Parent and fireclickdetector) then return false end
            if Rec.TpFirst and e.pos then TpTo(e.pos, 0) task.wait(0.15) end
            pcall(fireclickdetector, e.inst)
            return true
        end
        return false
    end

    local function StartLoop()
        if Rec.LoopRunning then return end
        Rec.LoopRunning = true
        task.spawn(function()
            while Rec.LoopOn and Rec.Alive do
                local ran = false
                for _, e in ipairs(Rec.Log) do
                    if not (Rec.LoopOn and Rec.Alive) then break end
                    if Rec.Loops[e.id] then
                        ran = true
                        RunEntry(e)
                        task.wait(Rec.LoopDelay)
                    end
                end
                if not ran then task.wait(0.3) end
                task.wait()
            end
            Rec.LoopRunning = false
        end)
    end

    ------------------------------------------------------------
    -- INSTANT PROMPTS (HoldDuration = 0)
    ------------------------------------------------------------
    local InstantOn, instantConn = false, nil
    local origHold = setmetatable({}, {__mode = "k"})
    local function MakeInstant(p)
        if p:IsA("ProximityPrompt") then
            if origHold[p] == nil then origHold[p] = p.HoldDuration end
            p.HoldDuration = 0
        end
    end
    local function SetInstant(on)
        InstantOn = on == true
        if instantConn then instantConn:Disconnect() instantConn = nil end
        if InstantOn then
            task.spawn(function()
                local n = 0
                for _, d in ipairs(workspace:GetDescendants()) do
                    if not InstantOn then return end
                    MakeInstant(d)
                    n += 1
                    if n % 500 == 0 then task.wait() end
                end
            end)
            instantConn = workspace.DescendantAdded:Connect(function(d)
                if InstantOn then MakeInstant(d) end
            end)
        else
            for p, h in pairs(origHold) do pcall(function() p.HoldDuration = h end) end
            origHold = setmetatable({}, {__mode = "k"})
        end
    end

