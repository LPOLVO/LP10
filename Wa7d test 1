local function BuildRecorder()
    local Players = game:GetService("Players")
    local PPS = game:GetService("ProximityPromptService")
    local LocalPlayer = Players.LocalPlayer
    local genv = (getgenv and getgenv()) or _G

    local MAX_ENTRIES, FOLDER, NOISE_LIMIT = 400, "LP10_Recorder", 8

    local Rec = {
        Log = {}, NextId = 1, Recording = false, Start = os.clock(),
        Muted = {}, Rate = {}, Loops = {}, LoopOn = false, LoopDelay = 0.3,
        TpFirst = false, Alive = true, Rows = {}, SuppressUntil = 0,
        HookOK = false, LoopRunning = false, GameName = nil,
    }
    local LibObjs = {}
    local RefreshStatus, AddRow, Notify, SetRecording, SetLoop, SetTpFirst

    task.spawn(function()
        local ok, info = pcall(function()
            return game:GetService("MarketplaceService"):GetProductInfo(game.PlaceId)
        end)
        Rec.GameName = (ok and info and info.Name) or ("PlaceId " .. tostring(game.PlaceId))
    end)

    ------------------------------------------------------------
    -- SERIALIZATION
    ------------------------------------------------------------
    local KEYWORDS = {}
    for w in ("and break do else elseif end false for function if in local nil not or repeat return then true until while continue"):gmatch("%S+") do
        KEYWORDS[w] = true
    end
    local CLASH = {Name = true, Parent = true, ClassName = true, Archivable = true}

    local function IsIdent(s)
        return type(s) == "string" and s:match("^[%a_][%w_]*$") ~= nil and not KEYWORDS[s] and not CLASH[s]
    end

    local function PathOf(inst)
        local chain, cur = {}, inst
        while cur and cur ~= game do
            table.insert(chain, 1, cur)
            cur = cur.Parent
        end
        if cur ~= game then return ("nil --[[%s]]"):format(tostring(inst.Name)) end
        local out = "game"
        for i, o in ipairs(chain) do
            if i == 1 and pcall(game.GetService, game, o.ClassName) then
                out = ("game:GetService(%q)"):format(o.ClassName)
            elseif IsIdent(o.Name) then
                out = out .. "." .. o.Name
            else
                out = out .. ("[%q]"):format(o.Name)
            end
        end
        return out
    end

    local function DotPath(inst)
        if typeof(inst) ~= "Instance" then return tostring(inst) end
        local ok, s = pcall(function() return inst:GetFullName() end)
        return ok and s or tostring(inst)
    end

    local function Ser(v, depth, seen)
        depth = depth or 0
        local t = typeof(v)
        if t == "string" then
            return string.format("%q", v)
        elseif t == "number" then
            if v ~= v then return "0/0" end
            if v == math.huge then return "math.huge" end
            if v == -math.huge then return "-math.huge" end
            return tostring(v)
        elseif t == "boolean" or t == "nil" then
            return tostring(v)
        elseif t == "Vector3" then
            return ("Vector3.new(%s, %s, %s)"):format(v.X, v.Y, v.Z)
        elseif t == "Vector2" then
            return ("Vector2.new(%s, %s)"):format(v.X, v.Y)
        elseif t == "CFrame" then
            return "CFrame.new(" .. table.concat({v:GetComponents()}, ", ") .. ")"
        elseif t == "Color3" then
            return ("Color3.new(%s, %s, %s)"):format(v.R, v.G, v.B)
        elseif t == "UDim2" then
            return ("UDim2.new(%s, %s, %s, %s)"):format(v.X.Scale, v.X.Offset, v.Y.Scale, v.Y.Offset)
        elseif t == "BrickColor" then
            return ("BrickColor.new(%q)"):format(v.Name)
        elseif t == "EnumItem" then
            return tostring(v)
        elseif t == "Instance" then
            return PathOf(v)
        elseif t == "table" then
            if depth >= 4 then return "{} --[[max depth]]" end
            seen = seen or {}
            if seen[v] then return "nil --[[cycle]]" end
            seen[v] = true
            local parts, n, count = {}, #v, 0
            for _ in pairs(v) do count += 1 end
            if count == n then
                for i = 1, n do parts[#parts + 1] = Ser(v[i], depth + 1, seen) end
            else
                for k, val in pairs(v) do
                    local key = (type(k) == "string" and IsIdent(k)) and k or ("[" .. Ser(k, depth + 1, seen) .. "]")
                    parts[#parts + 1] = key .. " = " .. Ser(val, depth + 1, seen)
                end
            end
            seen[v] = nil
            return "{" .. table.concat(parts, ", ") .. "}"
        end
        return ("nil --[[%s]]"):format(t)
    end

    local function SerArgs(args)
        local parts = {}
        for i = 1, args.n or #args do parts[i] = Ser(args[i]) end
        return table.concat(parts, ", ")
    end

