-- 🍬 AUTO CANDY + 🚪 AUTO KNOCK  (Escape Cops For Luckyblocks - Halloween event)
-- Route recorded by LP10 Recorder: teleports to each spot, fires the real remote.
----------------------------------------------------------------
local function BuildHalloweenAuto()
    local Players = game:GetService("Players")
    local RS = game:GetService("ReplicatedStorage")
    local lp = Players.LocalPlayer

    -- {candyId, x, y, z}
    local CANDY = {
        {107, -326.3, 26.5, -7244.8},
        {112, -328.7, 26.5, -7267.9},
        {119, -314.3, 26.5, -7296},
        {122, -317.1, 26.5, -7324.2},
        {137, -331.7, 26.5, -7394.1},
        {141, -326.8, 26.5, -7407},
        {139, -328.3, 26.5, -7417.6},
        {145, -337.9, 26.5, -7425.2},
        {142, -348.7, 26.5, -7419.6},
        {136, -362.7, 26.2, -7412.1},
        {143, -376.5, 26.1, -7405.8},
        {140, -381.2, 26.1, -7397.9},
        {146, -389, 26.1, -7392.7},
        {157, -391.8, 26.1, -7397.9},
        {155, -396, 26.1, -7420.5},
        {156, -401.8, 26.5, -7428.2},
        {163, -405.5, 26.5, -7434.5},
        {161, -417.4, 26.5, -7428.5},
        {172, -427.7, 26.5, -7416.9},
        {158, -421, 26.3, -7354.7},
        {177, -424.5, 26.5, -7346.6},
        {194, -425.4, 26.5, -7297.9},
    }
    -- {"HouseName@x,z", x, y, z}
    local HOUSES = {
        {"House1@-339,-7309", -330.8, 26.5, -7303.1},
        {"House5@-451,-7374", -443.3, 26.5, -7381.4},
        {"House4@-417,-7376", -423.1, 26.5, -7372.6},
        {"HalloweenGhostHouse@-411,-7312", -419.2, 27.4, -7311.5},
    }

    local S = {candy = false, knock = false, cDelay = 0.3, kDelay = 2.0, running = false, alive = true, origin = nil}

    local function Root()
        local ch = lp.Character
        return ch and ch:FindFirstChild("HumanoidRootPart")
    end
    local function Go(x, y, z)
        local r = Root()
        if r then
            r.CFrame = CFrame.new(x, y, z)
            r.AssemblyLinearVelocity = Vector3.zero
        end
    end
    local function GetRemote(name)
        local ok, r = pcall(function()
            return RS:WaitForChild("Remotes", 3):WaitForChild("Halloween", 3):WaitForChild(name, 3)
        end)
        return ok and r or nil
    end

    local function Worker()
        if S.running then return end
        S.running = true
        local r0 = Root()
        S.origin = r0 and r0.CFrame
        task.spawn(function()
            while S.alive and (S.candy or S.knock) do
                if S.candy then
                    local remote = GetRemote("Collect")
                    if remote then
                        for _, c in ipairs(CANDY) do
                            if not (S.candy and S.alive) then break end
                            Go(c[2], c[3], c[4])
                            pcall(remote.FireServer, remote, c[1])
                            task.wait(S.cDelay)
                        end
                    else
                        task.wait(1)
                    end
                end
                if S.knock then
                    local remote = GetRemote("TrickOrTreat")
                    if remote then
                        for _, h in ipairs(HOUSES) do
                            if not (S.knock and S.alive) then break end
                            Go(h[2], h[3], h[4])
                            task.wait(0.15)
                            pcall(remote.FireServer, remote, h[1])
                            task.wait(S.kDelay)
                        end
                    else
                        task.wait(1)
                    end
                end
                task.wait(0.2)
            end
            local r1 = Root()
            if S.origin and r1 then r1.CFrame = S.origin end
            S.running = false
        end)
    end

    local function AddRows()
        AddSection("HALLOWEEN AUTO")
        AddToggleFeature({Name = "Auto Candy", Icon = "🍬", Default = false, Callback = function(v)
            S.candy = v
            if v then Worker() end
        end})
        AddToggleFeature({Name = "Auto Knock (Trick or Treat)", Icon = "🚪", Default = false, Callback = function(v)
            S.knock = v
            if v then Worker() end
        end})
        AddSlider({Name = "Candy Delay", Min = 50, Max = 1500, Step = 50, Suffix = " ms", Default = 300,
            Callback = function(v) S.cDelay = v / 1000 end})
        AddSlider({Name = "Knock Delay", Min = 500, Max = 5000, Step = 250, Suffix = " ms", Default = 2000,
            Callback = function(v) S.kDelay = v / 1000 end})
    end

    return {AddRows = AddRows, Destroy = function() S.alive = false S.candy = false S.knock = false end}
end

