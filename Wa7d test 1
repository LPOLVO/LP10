-- ───────────── TOGGLE ─────────────
-- AddToggle({Name=, Icon=, Default=, Callback=})  or  AddToggle(name, default, callback, icon)
local function AddToggleFeature(a, b, c, d)
    local opt = type(a) == "table" and a or {Name = a, Default = b, Callback = c, Icon = d}
    local name = tostring(opt.Name or "Toggle")
    local state = opt.Default == true

    local card, cardStroke = Row(46)
    New("TextLabel", card, {
        Size = UDim2.fromOffset(30, 46), Position = UDim2.fromOffset(8, 0),
        BackgroundTransparency = 1, Text = tostring(opt.Icon or NextIcon()),
        TextSize = 20, ZIndex = 23,
    })
    RowLabel(card, name, 42, 0, {1, -108}, 46, {TextSize = 12})

    local track = New("Frame", card, {
        Size = UDim2.fromOffset(42, 22), Position = UDim2.new(1, -54, 0.5, -11),
        BackgroundColor3 = C.off, BorderSizePixel = 0, ZIndex = 23,
    })
    Corner(track, 11)
    local trackStroke = Stroke(track, C.orange, 1, 0.35)
    local knob = New("Frame", track, {
        Size = UDim2.fromOffset(16, 16), Position = UDim2.fromOffset(3, 3),
        BackgroundColor3 = C.text, BorderSizePixel = 0, ZIndex = 24,
    })
    Corner(knob, 8)

    local hit = New("TextButton", card, {
        Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Text = "", ZIndex = 26,
    })

    local function Apply(animate)
        local dur = animate and 0.18 or 0
        Play(track, dur, {BackgroundColor3 = state and C.orange or C.off}):Play()
        Play(trackStroke, dur, {Color = state and C.flame or C.orange}):Play()
        Play(knob, dur, {
            Position = state and UDim2.fromOffset(23, 3) or UDim2.fromOffset(3, 3),
            BackgroundColor3 = state and C.black or C.text,
        }, Enum.EasingStyle.Back):Play()
    end
    Apply(false)
    Flags[name] = state

    local function SetState(value, silent, burst)
        state = value == true
        Flags[name] = state
        Apply(true)
        if burst and state then Burst(knob.AbsolutePosition + knob.AbsoluteSize / 2, 4) end
        if not silent then SafeCall(opt.Callback, state) end
    end

    hit.MouseEnter:Connect(function() Play(cardStroke, 0.14, {Transparency = 0.15}):Play() end)
    hit.MouseLeave:Connect(function() Play(cardStroke, 0.14, {Transparency = 0.55}):Play() end)
    hit.MouseButton1Click:Connect(function() SetState(not state, false, true) end)

    if state then task.defer(SafeCall, opt.Callback, true) end

    local entry = Register(card, true, function()
        Flags[name] = nil
        if state then   -- tell the feature to stop (so old-game loops don't keep running)
            state = false
            SafeCall(opt.Callback, false)
        end
    end)
    return MakeObject(entry, function() return state end, function(v, silent) SetState(v, silent) end)
end

