        {"House4@-12,-7127", -11, 27, -7127},
        {"House5@30,-7143", 21.7, 26.2, -7138.9},
        {"HalloweenGhostHouse@-10,-7199", -8.2, 27.8, -7196.9},
        {"House1@27,-7203", 18.6, 29.5, -7202},
        {"House1@-7,-7298", -7.8, 28.2, -7297.9},
        {"House4@26,-7289", 18.5, 28.8, -7289},
        {"HalloweenHouse4@31,-7358", 26.8, 28.1, -7357.4},
        {"FrankesteinHouse@-15,-7376", -13.6, 29.3, -7377.8},
        {"House4@-89,-7353", -88.6, 29.1, -7354.8},
        {"HalloweenGhostHouse@-86,-7289", -88.2, 26.1, -7289.3},
        {"HalloweenGhostHouse@-93,-7438", -95.8, 27, -7437.2},
        {"House1@-140,-7454", -138, 27.7, -7454},
        {"House5@-211,-7458", -208.3, 27.2, -7457.2},
        {"House4@-294,-7454", -293.1, 29.5, -7454.6},
    }
    local KNOWN_NAMES = {House1 = true, House4 = true, House5 = true, HalloweenHouse4 = true,
        HalloweenGhostHouse = true, FrankesteinHouse = true}

    local S = {
        collect = false, scan = true, tpCollect = false,
        knock = false, tp = true, extra = true,
        cInterval = 1.0, maxId = 700, reps = 2, repGap = 0.6, kDelay = 1.2,
        alive = true, cRunning = false, tRunning = false, kRunning = false,
        candyList = {}, lastScan = 0, lastBrute = 0,
        houseList = {}, extraSeen = {},
    }
    for _, h in ipairs(HOUSES) do
        S.houseList[#S.houseList + 1] = {strs = {h[1]}, x = h[2], y = h[3], z = h[4]}
    end

    local function Root()
        local ch = lp.Character
        return ch and ch:FindFirstChild("HumanoidRootPart")
    end
    local function Go(x, y, z)
        local r = Root()
        if r then
            r.CFrame = CFrame.new(x, y, z)
            r.AssemblyLinearVelocity = Vector3.zero
        end
    end
    local function GetRemote(name)
        local ok, r = pcall(function()
            local rem = RS:FindFirstChild("Remotes")
            local folder = rem and rem:FindFirstChild("Halloween")
            return (folder and folder:FindFirstChild(name)) or RS:FindFirstChild(name, true)
        end)
        return ok and r or nil
    end

    ------------------------------------------------------------
    -- CANDY
    ------------------------------------------------------------
    local function IsCandyName(n)
        local l = n:lower()
        return l:find("candy", 1, true) ~= nil and not l:find("candies", 1, true) and not l:find("folder", 1, true)
    end

    local function ScanCandy()
        local found, seen, n = {}, {}, 0
        for _, d in ipairs(workspace:GetDescendants()) do
            n += 1
            if n % 600 == 0 then task.wait() end
            if (d:IsA("BasePart") or d:IsA("Model")) and IsCandyName(d.Name) then
                local top, cur = d, d.Parent
                while cur and cur ~= workspace and (cur:IsA("Model") or cur:IsA("BasePart")) and IsCandyName(cur.Name) do
                    top = cur
                    cur = cur.Parent
                end
                if not seen[top] then
                    seen[top] = true
                    found[#found + 1] = top
                end
            end
        end
        S.candyList = found
        S.lastScan = os.clock()
    end

    local function FindId(inst)
        local cur = inst
        for _ = 0, 3 do
            if not cur or cur == workspace then break end
            local num = tonumber(cur.Name)
            if num then return num end
            local ok, attrs = pcall(function() return cur:GetAttributes() end)
            if ok then
                for k, v in pairs(attrs) do
                    if type(v) == "number" then
                        local lk = tostring(k):lower()
                        if lk:find("id", 1, true) or lk == "index" or lk == "num" then return v end
                    end
                end
            end
            for _, ch in ipairs(cur:GetChildren()) do
                if (ch:IsA("IntValue") or ch:IsA("NumberValue")) and ch.Name:lower():find("id", 1, true) then
                    return ch.Value
                end
            end
            cur = cur.Parent
        end
        return nil
    end

    local function PartOf(c)
        return c:IsA("BasePart") and c or c:FindFirstChildWhichIsA("BasePart", true)
    end

    local function CollectOne(c, remote)
        local id = FindId(c)
        if id and remote then pcall(remote.FireServer, remote, id) end
        local prompt = c:FindFirstChildWhichIsA("ProximityPrompt", true)
        if prompt and fireproximityprompt then pcall(fireproximityprompt, prompt) end
        local cd = c:FindFirstChildWhichIsA("ClickDetector", true)
        if cd and fireclickdetector then pcall(fireclickdetector, cd) end
        local part, r = PartOf(c), Root()
        if part and r and firetouchinterest then
            pcall(firetouchinterest, r, part, 0)
            pcall(firetouchinterest, r, part, 1)
        end
    end

    local function CollectCycle()
        if os.clock() - S.lastScan > 3 then ScanCandy() end
        local remote = GetRemote("Collect")
        for _, c in ipairs(S.candyList) do
            if c.Parent then pcall(CollectOne, c, remote) end
        end
        -- fire every possible candy id (invalid ids are ignored by the game)
        if S.scan and remote and os.clock() - S.lastBrute >= math.max(S.cInterval, 2) then
            S.lastBrute = os.clock()
            for id = 1, S.maxId do
                if not (S.collect and S.alive) then break end
                pcall(remote.FireServer, remote, id)
                if id % 50 == 0 then task.wait() end
            end
        end
    end

    local function CollectWorker()
        if S.cRunning then return end
        S.cRunning = true
        task.spawn(function()
            while S.alive and S.collect do
                local ok, err = pcall(CollectCycle)
                if not ok then warn("[LP10 HALLOWEEN] collect error: " .. tostring(err)) end
                task.wait(S.cInterval)
            end
            S.cRunning = false
        end)
    end

    -- backup mode: fly to each candy it can see and collect it there
    local function TpCollectWorker()
        if S.tRunning then return end
        S.tRunning = true
        task.spawn(function()
            local r0 = Root()
            local origin = r0 and r0.CFrame
            while S.alive and S.tpCollect do
                local ok, err = pcall(function()
                    if os.clock() - S.lastScan > 3 then ScanCandy() end
                    local remote = GetRemote("Collect")
                    for _, c in ipairs(S.candyList) do
                        if not (S.tpCollect and S.alive) then break end
                        local part = c.Parent and PartOf(c)
                        if part then
                            local p = part.Position
                            Go(p.X, p.Y + 3, p.Z)
                            task.wait(0.08)
                            CollectOne(c, remote)
                            task.wait(0.05)
                        end
                    end
                end)
                if not ok then warn("[LP10 HALLOWEEN] tp-collect error: " .. tostring(err)) end
                task.wait(0.5)
            end
            local r1 = Root()
            if origin and r1 then r1.CFrame = origin end
            S.tRunning = false
        end)
    end

    ------------------------------------------------------------
    -- HOUSES
    ------------------------------------------------------------
    local function NearKnown(x, z)
        for _, h in ipairs(S.houseList) do
            if math.abs(h.x - x) < 14 and math.abs(h.z - z) < 14 then return true end
        end
        return false
    end

    local function ScanExtraHouses()
        local n = 0
        for _, d in ipairs(workspace:GetDescendants()) do
            n += 1
            if n % 600 == 0 then task.wait() end
            if (d:IsA("Model") or d:IsA("BasePart")) and not S.extraSeen[d]
                and (KNOWN_NAMES[d.Name] or d.Name:match("^House%d+$")) then
                S.extraSeen[d] = true
                local ok, pos = pcall(function()
                    return d:IsA("Model") and d:GetPivot().Position or d.Position
                end)
                if ok and pos and not NearKnown(pos.X, pos.Z) then
                    local fx, fz = math.floor(pos.X), math.floor(pos.Z)
                    local rx, rz = math.floor(pos.X + 0.5), math.floor(pos.Z + 0.5)
                    local strs = {("%s@%d,%d"):format(d.Name, fx, fz)}
                    if rx ~= fx or rz ~= fz then strs[2] = ("%s@%d,%d"):format(d.Name, rx, rz) end
                    S.houseList[#S.houseList + 1] = {strs = strs, x = pos.X, y = 28, z = pos.Z}
                end
            end
        end
    end

    local function KnockCycle()
        if S.extra then ScanExtraHouses() end
        local remote = GetRemote("TrickOrTreat")
        if not remote then task.wait(1) return end
        for _, h in ipairs(S.houseList) do
            if not (S.knock and S.alive) then break end
            if S.tp then
                Go(h.x, h.y, h.z)
                task.wait(0.35)
            end
            -- knock, then knock again (first knock sometimes gives nothing)
            for _ = 1, S.reps do
                if not (S.knock and S.alive) then break end
                for _, str in ipairs(h.strs) do pcall(remote.FireServer, remote, str) end
                task.wait(S.repGap)
            end
            task.wait(S.kDelay)
        end
    end

    local function KnockWorker()
        if S.kRunning then return end
        S.kRunning = true
        task.spawn(function()
            local r0 = Root()
            local origin = r0 and r0.CFrame
            while S.alive and S.knock do
                local ok, err = pcall(KnockCycle)
                if not ok then warn("[LP10 HALLOWEEN] knock error: " .. tostring(err)) task.wait(1) end
                task.wait(0.2)
            end
            local r1 = Root()
            if S.tp and origin and r1 then r1.CFrame = origin end
            S.kRunning = false
        end)
    end

    ------------------------------------------------------------
    -- DEBUG INFO (copy and send it if something does not work)
    ------------------------------------------------------------
    local function Dump()
        pcall(ScanCandy)
        local L = {"== LP10 HALLOWEEN DEBUG ==", ("PlaceId: %s"):format(tostring(game.PlaceId))}
        L[#L + 1] = ("Candy objects found: %d"):format(#S.candyList)
        for i, c in ipairs(S.candyList) do
            if i > 25 then break end
            local attrs = {}
            local ok, a = pcall(function() return c:GetAttributes() end)
            if ok then for k, v in pairs(a) do attrs[#attrs + 1] = tostring(k) .. "=" .. tostring(v) end end
            local kids = {}
            for j, ch in ipairs(c:GetChildren()) do
                if j > 8 then break end
                kids[#kids + 1] = ch.Name .. ":" .. ch.ClassName
            end
            L[#L + 1] = ("  %s [%s] id=%s attrs{%s} kids{%s}"):format(
                c:GetFullName(), c.ClassName, tostring(FindId(c)), table.concat(attrs, ","), table.concat(kids, ","))
        end
        L[#L + 1] = ("Houses in list: %d"):format(#S.houseList)
        local ok, folder = pcall(function() return RS.Remotes.Halloween end)
        if ok and folder then
            L[#L + 1] = "Remotes.Halloween:"
            for _, r in ipairs(folder:GetChildren()) do L[#L + 1] = ("  %s [%s]"):format(r.Name, r.ClassName) end
        end
        local text = table.concat(L, "\n")
        print(text)
        local fn = setclipboard or toclipboard
        if fn then pcall(fn, text) end
    end

    ------------------------------------------------------------
    -- MENU ROWS
    ------------------------------------------------------------
    local function AddRows()
        AddSection("HALLOWEEN EVENT")
        AddToggleFeature({Name = "Instant Collect Candy", Icon = "🍬", Default = false, Callback = function(v)
            S.collect = v
            if v then CollectWorker() end
        end})
        AddToggleFeature({Name = "Scan All Candy IDs", Icon = "🔢", Default = true, Callback = function(v)
            S.scan = v
        end})
        AddToggleFeature({Name = "Teleport Collect (backup)", Icon = "🧲", Default = false, Callback = function(v)
            S.tpCollect = v
            if v then TpCollectWorker() end
        end})
        AddToggleFeature({Name = "Auto Knock (Trick or Treat)", Icon = "🚪", Default = false, Callback = function(v)
            S.knock = v
            if v then KnockWorker() end
        end})
        AddToggleFeature({Name = "Teleport to Houses", Icon = "📍", Default = true, Callback = function(v)
            S.tp = v
        end})
        AddToggleFeature({Name = "Find Extra Houses", Icon = "🏚️", Default = true, Callback = function(v)
            S.extra = v
        end})
        AddSlider({Name = "Collect Interval", Min = 500, Max = 5000, Step = 100, Suffix = " ms", Default = 1000,
            Callback = function(v) S.cInterval = v / 1000 end})
        AddSlider({Name = "Max Candy ID", Min = 100, Max = 1500, Step = 50, Default = 700,
            Callback = function(v) S.maxId = v end})
        AddSlider({Name = "Knocks per House", Min = 1, Max = 5, Step = 1, Default = 2,
            Callback = function(v) S.reps = v end})
        AddSlider({Name = "Knock Delay", Min = 300, Max = 5000, Step = 100, Suffix = " ms", Default = 1200,
            Callback = function(v) S.kDelay = v / 1000 end})
        if Config.Debug then
            AddButtonFeature({Name = "Copy Debug Info", Icon = "🧪", Text = "COPY", Callback = Dump})
        end
    end

    return {
        AddRows = AddRows,
        Dump = Dump,
        Destroy = function() S.alive = false S.collect = false S.knock = false S.tpCollect = false end,
    }
end

