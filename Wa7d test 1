    local function BuildLog()
        local L = {
            "== LP10 ACTION LOG ==",
            ("Game: %s | PlaceId: %s"):format(tostring(Rec.GameName or "?"), tostring(game.PlaceId)),
            ("Entries: %d | Remote hook: %s"):format(#Rec.Log, Rec.HookOK and "ON" or "NOT SUPPORTED"),
            "@player = my position when it happened | @target = object position",
            "------------------------------------------------",
        }
        for _, e in ipairs(Rec.Log) do
            local text
            if e.kind == "remote" then
                text = ("%s:%s(%s)"):format(e.path or e.title, e.method, e.sub or "")
            else
                text = e.title .. ((e.sub and e.sub ~= "") and ("  →  " .. e.sub) or "")
            end
            local line = ("#%d +%.1fs %-8s %s"):format(e.id, e.t, string.upper(e.kind), text)
            if e.pos then line ..= "  @player" .. V3S(e.pos) end
            if e.tpos then line ..= "  @target" .. V3S(e.tpos) end
            L[#L + 1] = line
        end
        return table.concat(L, "\n")
    end

    local function BuildScript()
        local L = {
            "-- Generated by LP10 Action Recorder",
            ("-- Game: %s (%s)"):format(tostring(Rec.GameName or "?"), tostring(game.PlaceId)),
            'local lp = game:GetService("Players").LocalPlayer',
            "local function tp(x, y, z)",
            "    local c = lp.Character",
            '    local r = c and c:FindFirstChild("HumanoidRootPart")',
            "    if r then r.CFrame = CFrame.new(x, y, z) end",
            "end",
            "",
        }
        local prevT, lastTp
        for _, e in ipairs(Rec.Log) do
            if e.kind == "remote" or e.kind == "prompt" or e.kind == "click" or e.kind == "waypoint" then
                if prevT then L[#L + 1] = ("task.wait(%.2f)"):format(math.clamp(e.t - prevT, 0.05, 2)) end
                prevT = e.t
                if e.pos and (e.kind == "waypoint" or not lastTp or (e.pos - lastTp).Magnitude > 4) then
                    L[#L + 1] = ("tp(%s, %s, %s)"):format(R1(e.pos.X), R1(e.pos.Y), R1(e.pos.Z))
                    lastTp = e.pos
                end
                if e.kind ~= "waypoint" then
                    local p = e.luaPath or ""
                    local line
                    if e.kind == "remote" then
                        line = ("%s:%s(%s)"):format(p, e.method, e.sub or "")
                    elseif e.kind == "prompt" then
                        line = ("fireproximityprompt(%s)"):format(p)
                    else
                        line = ("fireclickdetector(%s)"):format(p)
                    end
                    if p:sub(1, 3) == "nil" then line = "-- (instance not found) " .. line end
                    L[#L + 1] = line
                end
            end
        end
        return table.concat(L, "\n")
    end

    local function CopyText(text)
        local fn = setclipboard or toclipboard
        if not fn then return false end
        return (pcall(fn, text))
    end
    local function SaveFile(text, name)
        if not writefile then return false end
        pcall(function()
            if makefolder and isfolder and not isfolder(FOLDER) then makefolder(FOLDER) end
        end)
        return (pcall(writefile, FOLDER .. "/" .. name, text))
    end

