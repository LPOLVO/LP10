        task.delay(2.3, function()
            if Rec.Alive and StatusLabel.Parent then RefreshStatus() end
        end)
    end

    local function SetRWOpen(open)
        RW.Visible = open
        if open then
            RWResponsive()
            local target = RWScale.Scale
            RWScale.Scale = target * 0.9
            Play(RWScale, 0.22, {Scale = target}, Enum.EasingStyle.Back):Play()
            RefreshStatus()
        end
    end

    local function Flash(b, ok)
        local orig = b.BackgroundColor3
        b.BackgroundColor3 = ok and C.slime or C.red
        task.delay(0.35, function()
            if b.Parent then b.BackgroundColor3 = orig end
        end)
    end

    ------------------------------------------------------------
    -- CLONE A RECORDED ACTION INTO THE MAIN MENU
    ------------------------------------------------------------
    local function ShortName(e)
        local n = e.title:gsub("^Prompt: ", ""):gsub("^Click: ", "")
        return string.sub(n, 1, 22) .. " #" .. e.id
    end
    local function AddToLibrary(e)
        local name = ShortName(e)
        if e.kind == "waypoint" then
            AddButtonFeature({Name = "TP " .. name, Icon = "📍", Text = "TP", Callback = function() RunEntry(e) end})
        else
            AddButtonFeature({Name = name, Icon = "⚡", Text = "RUN", Callback = function() RunEntry(e) end})
            local token = 0
            AddToggleFeature({
                Name = "Auto " .. name, Icon = "🔁", Default = false,
                Callback = function(v)
                    token += 1
                    local my = token
                    if v then
                        task.spawn(function()
                            while token == my and Rec.Alive do
                                RunEntry(e)
                                task.wait(Rec.LoopDelay)
                            end
                        end)
                    end
                end,
            })
        end
        Notify("➕ Added to main menu (open 🎃)")
    end

    ------------------------------------------------------------
    -- ROWS
    ------------------------------------------------------------
    local function RowBtn(parent, text, offset, bg)
        local b = New("TextButton", parent, {
            Size = UDim2.fromOffset(26, 26), Position = UDim2.new(1, -(offset + 26), 0.5, -13),
            BackgroundColor3 = bg or C.off, AutoButtonColor = false, Text = text,
            TextColor3 = C.text, Font = Enum.Font.GothamBlack, TextSize = 12, ZIndex = 45,
        })
        Corner(b, 7)
        return b
    end

    AddRow = function(e)
        local row = New("Frame", RList, {
            Size = UDim2.new(1, -6, 0, 56), BackgroundColor3 = C.card, BorderSizePixel = 0,
            LayoutOrder = e.id, ZIndex = 42,
        })
        Corner(row, 9)
        Stroke(row, KIND_COLOR[e.kind] or C.orange, 1, 0.55)
        Rec.Rows[e.id] = row

        local runnable = e.kind == "remote" or e.kind == "prompt" or e.kind == "click"
        local nBtn = (e.kind == "remote" and 5) or (runnable and 4) or (e.kind == "waypoint" and 3) or 1
        local bw = nBtn * 26 + (nBtn - 1) * 3

        New("TextLabel", row, {
            Size = UDim2.fromOffset(26, 56), Position = UDim2.fromOffset(4, 0), BackgroundTransparency = 1,
            Text = KIND_ICON[e.kind] or "•", TextSize = 16, ZIndex = 44,
        })
        local tw = UDim2.new(1, -(34 + bw + 8), 0, 15)
        local function TL(y, h, text, size, color, font)
            New("TextLabel", row, {
                Size = UDim2.new(tw.X.Scale, tw.X.Offset, 0, h), Position = UDim2.fromOffset(32, y),
                BackgroundTransparency = 1, Text = text, TextColor3 = color, Font = font,
                TextSize = size, TextXAlignment = Enum.TextXAlignment.Left,
                TextTruncate = Enum.TextTruncate.AtEnd, ZIndex = 44,
            })
        end
        TL(5, 15, e.title, 10, C.text, Enum.Font.GothamBold)
        TL(21, 14, (e.sub and e.sub ~= "") and e.sub or "(no args)", 9, C.muted, Enum.Font.Gotham)
        TL(36, 14, ("+%.1fs  @%s"):format(e.t, V3S(e.pos)), 8, C.flame, Enum.Font.GothamSemibold)

        local off = 6
        local function Next() local o = off off = off + 29 return o end

        local del = RowBtn(row, "✖", Next(), C.off)
        del.MouseButton1Click:Connect(function() RemoveEntry(e.id) end)

        if e.kind == "remote" then
            local mute = RowBtn(row, "⛔", Next(), C.off)
            mute.MouseButton1Click:Connect(function()
                Rec.Muted[e.key] = true
                for i = #Rec.Log, 1, -1 do
                    local o = Rec.Log[i]
                    if o.kind == "remote" and o.key == e.key then RemoveEntry(o.id) end
                end
                Notify("⛔ Muted: " .. tostring(e.key))
            end)
        end
        if runnable or e.kind == "waypoint" then
            local add = RowBtn(row, "➕", Next(), C.purple)
            add.MouseButton1Click:Connect(function() AddToLibrary(e) end)
        end
        if runnable then
            local loop = RowBtn(row, "🔁", Next(), Rec.Loops[e.id] and C.orange or C.off)
            loop.MouseButton1Click:Connect(function()
                if Rec.Loops[e.id] then Rec.Loops[e.id] = nil else Rec.Loops[e.id] = true end
                loop.BackgroundColor3 = Rec.Loops[e.id] and C.orange or C.off
                Notify(Rec.Loops[e.id] and "🔁 Marked — turn LOOP on to run it" or "Unmarked")
            end)
        end
        if runnable or e.kind == "waypoint" then
            local run = RowBtn(row, "▶", Next(), C.slime)
            run.TextColor3 = C.black
            run.MouseButton1Click:Connect(function()
                task.spawn(function() Flash(run, RunEntry(e)) end)
            end)
        end

        if Rec.Recording then
            task.defer(function()
                if RList.Parent then RList.CanvasPosition = Vector2.new(0, RList.AbsoluteCanvasSize.Y) end
            end)
        end
    end

    ------------------------------------------------------------
    -- CONTROLS
    ------------------------------------------------------------
    SetRecording = function(on, fromLib)
        Rec.Recording = on == true
        if Rec.Recording and #Rec.Log == 0 then Rec.Start = os.clock() end
        if not fromLib and LibObjs.Rec then pcall(function() LibObjs.Rec:Set(Rec.Recording, true) end) end
        RefreshStatus()
    end
    SetLoop = function(on, fromLib)
        Rec.LoopOn = on == true
        if Rec.LoopOn then StartLoop() end
        if not fromLib and LibObjs.Loop then pcall(function() LibObjs.Loop:Set(Rec.LoopOn, true) end) end
        RefreshStatus()
    end
    SetTpFirst = function(on, fromLib)
        Rec.TpFirst = on == true
        if not fromLib and LibObjs.Tp then pcall(function() LibObjs.Tp:Set(Rec.TpFirst, true) end) end
        RefreshStatus()
    end

    BRec.MouseButton1Click:Connect(function() SetRecording(not Rec.Recording) end)
    BClear.MouseButton1Click:Connect(function()
        for id, row in pairs(Rec.Rows) do row:Destroy() end
        Rec.Rows, Rec.Log, Rec.Loops, Rec.NextId, Rec.Start = {}, {}, {}, 1, os.clock()
        RefreshStatus()
        Notify("🗑 Cleared")
    end)
    BMark.MouseButton1Click:Connect(function()
        local pos = MyPos()
        if not pos then Notify("⚠ character not found") return end
        local n = 0
        for _, e in ipairs(Rec.Log) do if e.kind == "waypoint" then n += 1 end end
        AddEntry({kind = "waypoint", title = "Waypoint #" .. (n + 1), sub = V3S(pos), pos = pos})
    end)
    BLog.MouseButton1Click:Connect(function()
        local ok = CopyText(BuildLog())
        Notify(ok and "✅ Log copied — paste it to Claude" or "⚠ clipboard not supported (use SAVE FILE)")
    end)
    BScript.MouseButton1Click:Connect(function()
        local ok = CopyText(BuildScript())
        Notify(ok and "✅ Replay script copied" or "⚠ clipboard not supported (use SAVE FILE)")
    end)
    BSave.MouseButton1Click:Connect(function()
        local base = ("%s_%d"):format(tostring(game.PlaceId), os.time())
        local ok1 = SaveFile(BuildLog(), base .. ".txt")
        local ok2 = SaveFile(BuildScript(), base .. ".lua")
        Notify((ok1 and ok2) and ("💾 Saved in " .. FOLDER .. "/") or "⚠ writefile not supported")
    end)
    BUnmute.MouseButton1Click:Connect(function()
        Rec.Muted, Rec.Rate = {}, {}
        Notify("🔊 All remotes unmuted")
    end)
    BTp.MouseButton1Click:Connect(function() SetTpFirst(not Rec.TpFirst) end)
    BLoop.MouseButton1Click:Connect(function() SetLoop(not Rec.LoopOn) end)
    RClose.MouseButton1Click:Connect(function() SetRWOpen(false) end)

    -- floating 🎥 button (always available, even after Lib.Clear())
    local RecBtn = New("TextButton", ScreenGui, {
        Name = "RecorderToggle", Size = UDim2.fromOffset(40, 40), Position = UDim2.new(0.07, 7, 0.18, 64),
        BackgroundColor3 = C.panel, AutoButtonColor = false, Text = "🎥", TextSize = 20,
        Font = Enum.Font.GothamBlack, Visible = false, ZIndex = 30,
    })
    Corner(RecBtn, 20)
    local RecBtnStroke = Stroke(RecBtn, C.slime, 1.6, 0.1)
    Draggable(RecBtn, RecBtn)
    RecBtn.MouseButton1Click:Connect(function() SetRWOpen(not RW.Visible) end)
    task.spawn(function()
        repeat task.wait(0.2) until Toggle.Visible or not Rec.Alive
        if Rec.Alive then RecBtn.Visible = true end
    end)

    Track(RunService.Heartbeat:Connect(function()
        local mix = (math.sin(os.clock() * 4) + 1) / 2
        if Rec.Recording then
            RWStroke.Color = C.red:Lerp(C.orange, mix)
            RecBtnStroke.Color = C.red:Lerp(C.orange, mix)
        else
            RWStroke.Color = C.slime
            RecBtnStroke.Color = C.slime
        end
    end))

    ------------------------------------------------------------
    -- MAIN MENU ROWS
    ------------------------------------------------------------
    local function AddRecorder()
        AddSection("RECORDER")
        AddButtonFeature({Name = "Open Recorder Window", Icon = "🎥", Text = "OPEN", Callback = function() SetRWOpen(true) end})
        LibObjs.Rec = AddToggleFeature({Name = "Record Actions", Icon = "🔴", Default = Rec.Recording,
            Callback = function(v) SetRecording(v, true) end})
        LibObjs.Loop = AddToggleFeature({Name = "Loop Marked Actions", Icon = "🔁", Default = Rec.LoopOn,
            Callback = function(v) SetLoop(v, true) end})
        AddSlider({Name = "Loop Delay", Min = 50, Max = 2000, Step = 50, Suffix = " ms",
            Default = math.floor(Rec.LoopDelay * 1000), Callback = function(v) Rec.LoopDelay = v / 1000 end})
        LibObjs.Tp = AddToggleFeature({Name = "TP to action spot first", Icon = "📍", Default = Rec.TpFirst,
            Callback = function(v) SetTpFirst(v, true) end})
        AddToggleFeature({Name = "Instant Prompts (no hold)", Icon = "⚡", Default = InstantOn,
            Callback = function(v) SetInstant(v) end})
    end

    local function Destroy()
        Rec.Alive = false
        Rec.Recording, Rec.LoopOn = false, false
        pcall(SetInstant, false)
        if genv.__LP10_REC_HANDLER == OnRemote then genv.__LP10_REC_HANDLER = nil end
    end

    InstallHook()
    HookGame()
    RefreshStatus()

    return {AddRecorder = AddRecorder, Destroy = Destroy, Open = function() SetRWOpen(true) end, Rec = Rec}
end

local Recorder = BuildRecorder()
