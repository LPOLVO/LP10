    local function RootPart()
        local ch = LocalPlayer.Character
        return ch and ch:FindFirstChild("HumanoidRootPart")
    end
    local function MyPos()
        local r = RootPart()
        return r and r.Position
    end
    local function R1(n) return math.floor(n * 10 + 0.5) / 10 end
    local function V3S(v)
        return v and ("(%s, %s, %s)"):format(R1(v.X), R1(v.Y), R1(v.Z)) or "?"
    end
    local function TpTo(pos, raise)
        local r = RootPart()
        if r and pos then r.CFrame = CFrame.new(pos + Vector3.new(0, raise or 0, 0)) end
    end
    local function InstPos(i)
        if not i then return nil end
        local ok, p = pcall(function()
            if i:IsA("BasePart") then return i.Position end
            if i:IsA("Attachment") then return i.WorldPosition end
            if i:IsA("Model") then return i:GetPivot().Position end
            local par = i.Parent
            if par then
                if par:IsA("BasePart") then return par.Position end
                if par:IsA("Attachment") then return par.WorldPosition end
                if par:IsA("Model") then return par:GetPivot().Position end
            end
        end)
        return ok and p or nil
    end

