local function AutomationHumanoid()
    local character = AutomationPlayer and AutomationPlayer.Character
    return character and character:FindFirstChildOfClass("Humanoid")
end

local function AutomationRoot()
    local character = AutomationPlayer and AutomationPlayer.Character
    return character and character:FindFirstChild("HumanoidRootPart")
end

local function AutomationMove(cframe)
    local character = AutomationPlayer and AutomationPlayer.Character
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    local root = character and character:FindFirstChild("HumanoidRootPart")

    if not character or not humanoid or not root or humanoid.Health <= 0 then
        return false
    end

    character:PivotTo(cframe)
    root.AssemblyLinearVelocity = Vector3.zero
    root.AssemblyAngularVelocity = Vector3.zero
    return true
end

local function AutomationDamageNPCs()
    local folder = workspace:FindFirstChild("NPCs")
    local root = AutomationRoot()
    local npcApi = AutomationFlow and AutomationFlow.NPCs
    local total = 0

    if not folder or not root or not npcApi or type(npcApi.Damage) ~= "function" then
        return 0
    end

    for _, humanoid in ipairs(folder:GetDescendants()) do
        if humanoid:IsA("Humanoid") and humanoid.Health > 0 then
            local npc = humanoid:FindFirstAncestorOfClass("Model")
            local npcRoot = npc and npc:FindFirstChild("HumanoidRootPart")
            if npcRoot and (npcRoot.Position - root.Position).Magnitude <= 80 then
                if pcall(npcApi.Damage, humanoid, humanoid.Health + 1) then
                    total += 1
                end
            end
        end
    end

    return total
end

local function AutomationDataValue(name)
    local localData = AutomationFlow and AutomationFlow.LocalData
    if localData and type(localData.Get) == "function" then
        local ok, value = pcall(localData.Get, name)
        if ok and type(value) == "number" then
            return value
        end
    end

    local playerData = AutomationFlow and AutomationFlow.PlayerDataClient
    if playerData and type(playerData.getObserver) == "function" then
        local ok, observer = pcall(playerData.getObserver, name)
        if ok and observer and type(observer.get) == "function" then
            local read, value = pcall(observer.get, observer)
            if read and type(value) == "number" then
                return value
            end
        end
    end
end

local function AutomationOwnedCar()
    local playerData = AutomationFlow and AutomationFlow.PlayerDataClient
    if not playerData or type(playerData.getObserver) ~= "function" then
        return
    end

    local ok, observer = pcall(playerData.getObserver, "cars")
    if not ok or not observer or type(observer.get) ~= "function" then
        return
    end

    local read, cars = pcall(observer.get, observer)
    if not read or type(cars) ~= "table" then
        return
    end

    for carName in pairs(cars) do
        return tostring(carName)
    end
end

local function AutomationVisible(instance)
    local playerGui = AutomationPlayer and AutomationPlayer:FindFirstChildOfClass("PlayerGui")
    local current = instance

    while current and current ~= playerGui do
        if current:IsA("GuiObject") and not current.Visible then
            return false
        end
        if current:IsA("LayerCollector") and not current.Enabled then
            return false
        end
        current = current.Parent
    end

    return current == playerGui
end

local function AutomationEndScreen()
    local playerGui = AutomationPlayer and AutomationPlayer:FindFirstChildOfClass("PlayerGui")
    if not playerGui then
        return
    end

    local direct = playerGui:FindFirstChild("EndFrame", true)
    if direct and AutomationVisible(direct) then
        return direct
    end

    for _, item in ipairs(playerGui:GetDescendants()) do
        if item:IsA("GuiObject") and AutomationVisible(item) then
            local name = item.Name:lower()
            local text = (item:IsA("TextLabel") or item:IsA("TextButton"))
                and tostring(item.Text or ""):lower()
                or ""
            if name:find("escaped", 1, true) or name:find("captured", 1, true)
                or text:find("escaped", 1, true) or text:find("captured", 1, true) then
                return item:FindFirstAncestor("EndFrame") or item
            end
        end
    end
end

local function AutomationPrompt()
    local map = workspace:FindFirstChild("Map")
    local buildings = map and map:FindFirstChild("Buildings")
    local customs = buildings and buildings:FindFirstChild("CustomsFinal")
    local finalDoor = customs and customs:FindFirstChild("FinalDoor", true)

    if finalDoor then
        for _, item in ipairs(finalDoor:GetDescendants()) do
            if item:IsA("ProximityPrompt") then
                return item
            end
        end
    end

    for _, item in ipairs(workspace:GetDescendants()) do
        if item:IsA("ProximityPrompt") then
            local parentName = item.Parent and item.Parent:GetFullName():lower() or ""
            if parentName:find("final", 1, true) or parentName:find("gate", 1, true)
                or parentName:find("custom", 1, true) then
                return item
            end
        end
    end
end

local function AutomationPromptPosition(prompt)
    local holder = prompt and prompt.Parent
    if holder and holder:IsA("Attachment") then
        return holder.WorldPosition
    end
    if holder and holder:IsA("BasePart") then
        return holder.Position
    end
end

local function AutomationFirePrompt(prompt)
    if not prompt then
        return false
    end

    if type(fireproximityprompt) == "function" then
        local ok = pcall(fireproximityprompt, prompt)
        if ok then
            return true
        end
    end

    local ok = pcall(function()
        local duration = prompt.HoldDuration
        prompt.HoldDuration = 0
        prompt:InputHoldBegin()
        task.wait(0.1)
        prompt:InputHoldEnd()
        prompt.HoldDuration = duration
    end)
    return ok
end

local function AutomationGateSeconds(prompt)
    local finalDoor = prompt and prompt:FindFirstAncestor("FinalDoor")
    if not finalDoor then
        local map = workspace:FindFirstChild("Map")
        local buildings = map and map:FindFirstChild("Buildings")
        local customs = buildings and buildings:FindFirstChild("CustomsFinal")
        finalDoor = customs and customs:FindFirstChild("FinalDoor", true)
    end

    if not finalDoor then
        return
    end

    for _, label in ipairs(finalDoor:GetDescendants()) do
        if label:IsA("TextLabel") and AutomationVisible(label) then
            local minutes, seconds = label.Text:match("(%d+)%s*m%s*(%d+)%s*s")
            if not minutes then
                minutes, seconds = label.Text:match("(%d+)%s*:%s*(%d+)")
            end
            if minutes and seconds then
                return tonumber(minutes) * 60 + tonumber(seconds)
            end
        end
    end
end

function Automation:GetContext()
    if game.PlaceId == self.LobbyPlaceId then
        return "Lobby"
    end
    if game.PlaceId == self.GamePlaceId then
        return "Game"
    end
    if AutomationFlow and AutomationFlow.LobbyServer then
        return "Lobby"
    end
    if workspace:FindFirstChild("Map") then
        return "Game"
    end
    return "Unsupported"
end

function Automation:SetPhase(phase, detail)
    self.Phase = tostring(phase)
    self.Detail = tostring(detail or "")
    self:UpdateUI()
end

function Automation:UpdateUI()
    local elapsed = self.StartedAt > 0 and os.time() - self.StartedAt or 0
    local runElapsed = self.RunStartedAt > 0 and os.time() - self.RunStartedAt or 0
    local function duration(value)
        value = math.max(0, math.floor(tonumber(value) or 0))
        return string.format("%02d:%02d:%02d", math.floor(value / 3600), math.floor(value % 3600 / 60), value % 60)
    end

    if self.Controls.Status then
        self.Controls.Status.Text = "Status: " .. self.Phase .. "\n" .. self.Detail
    end
    if self.Controls.Stats then
        self.Controls.Stats.Text = string.format(
            "Session: %s | Runs: %d/%d\nFailures: %d | Retries: %d | NPC: %d\nCurrent run: %s | Gate: %s",
            duration(elapsed), self.Completed, self.Attempts, self.Failed, self.Retries,
            self.NPCRequests, duration(runElapsed), self.GateText or "--"
        )
    end
    if self.Controls.Error then
        self.Controls.Error.Text = "Last error: " .. tostring(self.LastError)
    end
end

function Automation:CreateTeleportLoader()
    local loader = tostring(AutomationEnv.LP10RunawaysTeleportLoader or ""):match("^%s*(.-)%s*$")
    if loader == "" then
        return
    end
    local queue = queue_on_teleport or queueonteleport
    if type(queue) == "function" then
        pcall(queue, loader)
    end
end

function Automation:ActivateGate(prompt, token)
    if not prompt then
        return false, "End gate prompt was not found"
    end

    local position = AutomationPromptPosition(prompt)
    local root = AutomationRoot()
    if position and root then
        local direction = root.Position.Z <= position.Z and 1 or -1
        AutomationMove(CFrame.lookAt(position - Vector3.new(0, 0, direction * 8), position, Vector3.yAxis))
    end

    self:SetPhase("Activating Gate", "Starting the gate countdown")
    for attempt = 1, 3 do
        if self.Token ~= token or not self.Running then
            return false, "Automation stopped"
        end

        local before = AutomationGateSeconds(prompt)
        if AutomationFirePrompt(prompt) then
            local expires = os.clock() + 6
            repeat
                local current = AutomationGateSeconds(prompt)
                if not prompt.Enabled or current and (not before or current < before or current < 120) then
                    self.GateStartedAt = os.time() - math.max(0, 120 - (current or 120))
                    self.GateActivations += 1
                    return true
                end
                task.wait(0.25)
            until os.clock() >= expires or not self.Running or self.Token ~= token
        end

        self.Retries += 1
        task.wait(attempt)
    end

    return false, "Gate activation was not confirmed"
end

function Automation:WaitForGate(prompt, token)
    local expires = os.clock() + self.GateTimeout
    local root = AutomationRoot()
    self:SetPhase("Waiting for Gate", "Waiting for the two minute countdown")

    if self.SafeGateWait and root then
        self.Root = root
        self.RootWasAnchored = root.Anchored
        root.Anchored = true
    end

    repeat
        if self.Token ~= token or not self.Running then
            return false, "Automation stopped"
        end

        local seconds = AutomationGateSeconds(prompt)
        self.GateText = seconds and (tostring(math.floor(seconds)) .. " seconds") or "--"
        self:UpdateUI()

        local endScreen = AutomationEndScreen()
        if endScreen then
            return false, "Result screen appeared"
        end

        if (seconds and seconds <= 0) or os.clock() - self.GateStartedAt >= 120 then
            break
        end
        task.wait(0.5)
    until os.clock() >= expires

    if self.Root and self.Root.Parent then
        self.Root.Anchored = self.RootWasAnchored == true
    end
    self.Root = nil
    self.RootWasAnchored = nil

    if os.clock() >= expires then
        return false, "Gate wait timed out"
    end
    return true
end

function Automation:CrossGate(token)
    local prompt = AutomationPrompt()
    local position = AutomationPromptPosition(prompt)
    local root = AutomationRoot()

    if not position or not root then
        return false, "Gate position is unavailable"
    end

    local direction = root.Position.Z <= position.Z and 1 or -1
    self:SetPhase("Entering Finish", "Crossing the opened gate")

    for _, offset in ipairs({ 8, 24, 55, 100 }) do
        if self.Token ~= token or not self.Running then
            return false, "Automation stopped"
        end

        local target = position + Vector3.new(0, 3, direction * offset)
        AutomationMove(CFrame.lookAt(target, target + Vector3.new(0, 0, direction), Vector3.yAxis))
        task.wait(0.35)

        if AutomationEndScreen() then
            return true
        end
    end

    return AutomationEndScreen() ~= nil, "Finish result did not appear"
end

function Automation:ReplayOrLobby(token)
    local endFrame = AutomationEndScreen()
    if not endFrame then
        return false, "Result screen was not found"
    end

    if self.AutoReplay then
        self.Replays += 1
        self:SetPhase("Auto Replay", "Submitting replay")

        if AutomationFlow and AutomationFlow.GameManager and type(AutomationFlow.GameManager.Replay) == "function" then
            local ok = pcall(AutomationFlow.GameManager.Replay)
            if ok then
                self:CreateTeleportLoader()
                return true
            end
        end

        for _, button in ipairs(endFrame:GetDescendants()) do
            if button:IsA("GuiButton") then
                local name = button.Name:lower()
                local text = button:IsA("TextButton") and button.Text:lower() or ""
                if name:find("replay", 1, true) or text:find("replay", 1, true) then
                    local ok = type(firesignal) == "function"
                        and pcall(firesignal, button.MouseButton1Click)
                        or pcall(button.Activate, button)
                    if ok then
                        self:CreateTeleportLoader()
                        return true
                    end
                end
            end
        end
    end

    if AutomationFlow and AutomationFlow.GameManager and type(AutomationFlow.GameManager.BackToLobby) == "function" then
        self:SetPhase("Returning to Lobby", "Replay unavailable")
        self:CreateTeleportLoader()
        return pcall(AutomationFlow.GameManager.BackToLobby)
    end

    return false, "Replay and lobby controls are unavailable"
end

function Automation:RunGame(token)
    self.RunStartedAt = os.time()
    self.Attempts += 1
    self:SetPhase("Loading Game", "Waiting for the map")

    local expires = os.clock() + 30
    repeat
        if AutomationHumanoid() and AutomationRoot() and workspace:FindFirstChild("Map") then
            break
        end
        task.wait(0.25)
    until os.clock() >= expires or not self.Running or self.Token ~= token

    if not self.Running or self.Token ~= token then
        return true
    end

    local prompt = AutomationPrompt()
    local activated, activationError = self:ActivateGate(prompt, token)
    if not activated then
        return false, activationError
    end

    local opened, gateError = self:WaitForGate(prompt, token)
    if not opened then
        self.Failed += 1
        return false, gateError
    end

    local crossed, crossError = self:CrossGate(token)
    if not crossed then
        self.Failed += 1
        return false, crossError
    end

    self.Completed += 1
    self.RunStartedAt = 0
    self.GateText = "--"
    return self:ReplayOrLobby(token)
end

function Automation:RunLobby(token)
    self:SetPhase("Lobby", "Waiting before the next run")
    task.wait(self.LobbyDelay)

    if self.Token ~= token or not self.Running then
        return true
    end

    if not AutomationFlow or not AutomationFlow.LobbyServer then
        return false, "Lobby API is unavailable"
    end

    local lobby = AutomationFlow.LobbyServer
    if type(lobby.play) == "function" then
        pcall(lobby.play)
    end

    local playerGui = AutomationPlayer:FindFirstChildOfClass("PlayerGui")
    local createGui = playerGui and (playerGui:FindFirstChild("CreateLobbyGui") or playerGui:WaitForChild("CreateLobbyGui", 10))
    local car = AutomationOwnedCar()

    if not createGui or not car or type(lobby.create) ~= "function" then
        return false, "Lobby creation is unavailable"
    end

    self:SetPhase("Creating Game", "Vehicle: " .. car)
    self:CreateTeleportLoader()
    local ok, result = pcall(lobby.create, {
        maxPlayers = 1,
        permissions = "Friends",
        car = car,
    })

    if not ok then
        return false, tostring(result)
    end
    return true
end

function Automation:Start()
    if self.Running then
        return
    end

    if not AutomationFlow then
        self.LastError = "FlowClient is unavailable"
        self:SetPhase("Start Failed", self.LastError)
        AutomationNotify(self.LastError)
        return
    end

    self.Running = true
    self.Token = {}
    self.StartedAt = os.time()
    self.Attempts = 0
    self.Completed = 0
    self.Failed = 0
    self.Retries = 0
    self.GateActivations = 0
    self.NPCRequests = 0
    self.Replays = 0
    self:SetPhase("Starting", "Automation enabled")

    task.spawn(function()
        local token = self.Token
        while self.Running and self.Token == token do
            local context = self:GetContext()
            local ok, result, detail = xpcall(function()
                if context == "Lobby" then
                    return self:RunLobby(token)
                elseif context == "Game" then
                    return self:RunGame(token)
                end
                return false, "Unsupported place: " .. tostring(game.PlaceId)
            end, function(errorMessage)
                if debug and type(debug.traceback) == "function" then
                    return debug.traceback(tostring(errorMessage), 2)
                end
                return tostring(errorMessage)
            end)

            if not ok then
                result, detail = false, tostring(result)
            end

            if not result and self.Running and self.Token == token then
                self.Retries += 1
                self.LastError = tostring(detail or "Automation failed")
                self:SetPhase("Retrying", self.LastError)
                task.wait(math.max(3, self.RetryDelay))
            elseif self.Running and self.Token == token then
                task.wait(1)
            end
        end
    end)

    task.spawn(function()
        local token = self.Token
        while self.Running and self.Token == token do
            if self:GetContext() == "Game" then
                self.NPCRequests += AutomationDamageNPCs()
            end
            self:UpdateUI()
            task.wait(0.5)
        end
    end)
end

function Automation:Stop()
    self.Running = false
    self.Token = nil
    if self.Root and self.Root.Parent then
        self.Root.Anchored = self.RootWasAnchored == true
    end
    self.Root = nil
    self.RootWasAnchored = nil
    self:SetPhase("Stopped", "Automation is disabled")
end

