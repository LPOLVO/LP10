    while current and current ~= playerGui do
        if current:IsA("GuiObject") and not current.Visible then return false end
        if current:IsA("LayerCollector") and not current.Enabled then return false end
        current = current.Parent
    end
    return current == playerGui
end

local function AutomationEndScreen()
    local playerGui = AutomationPlayer and AutomationPlayer:FindFirstChildOfClass("PlayerGui")
    if not playerGui then return end

    local endFrame = playerGui:FindFirstChild("EndFrame", true)
    if endFrame and AutomationVisible(endFrame) then
        local escaped = endFrame:FindFirstChild("Escaped", true)
        local captured = endFrame:FindFirstChild("Captured", true)
        local option = endFrame:FindFirstChild("Replay", true) or endFrame:FindFirstChild("Lobby", true)

        if escaped and AutomationVisible(escaped) then return endFrame, "Escaped" end
        if captured and AutomationVisible(captured) then return endFrame, "Captured" end
        if option and AutomationVisible(option) then return endFrame, "Ended" end

        for _, item in ipairs(endFrame:GetDescendants()) do
            if item:IsA("GuiObject") and AutomationVisible(item) then
                local name = item.Name:lower()
                local text = (item:IsA("TextLabel") or item:IsA("TextButton"))
                    and tostring(item.Text or ""):lower() or ""
                if name:find("captured", 1, true) or text:find("captured", 1, true) then
                    return endFrame, "Captured"
                end
                if name:find("escaped", 1, true) or text:find("escaped", 1, true) then
                    return endFrame, "Escaped"
                end
            end
        end
        return
    end
end

