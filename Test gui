local function dur(v)
    v = math.max(0, math.floor(tonumber(v) or 0))
    return string.format("%02d:%02d:%02d", math.floor(v/3600), math.floor(v%3600/60), v%60)
end

LP10UI.update = function()
    local elapsed = AutoFarm.StartedAt > 0 and os.time() - AutoFarm.StartedAt or 0
    local runElapsed = AutoFarm.RunStartedAt > 0 and os.time() - AutoFarm.RunStartedAt or 0

    StatusLabel.Text = "Status: " .. AutoFarm.Phase .. "\n" .. AutoFarm.Detail
    StatsLabel.Text = string.format(
        "Session: %s | Runs: %d/%d\nFailures: %d | Retries: %d | NPC: %d\nCurrent run: %s | Gate: %s",
        dur(elapsed), AutoFarm.Stats.Completed, AutoFarm.Stats.Attempts,
        AutoFarm.Stats.Failed, AutoFarm.Stats.Retries, AutoFarm.Stats.NPCAttacks,
        dur(runElapsed), AutoFarm.GateText or "--"
    )
    ErrorLabel.Text = "Last error: " .. tostring(AutoFarm.LastError)

    -- sync toggle visuals with actual state
    if AutoFarm.Running and not LP10UI.toggles.autoFarm then
        autoFarmSet(true, false)
        LP10UI.toggles.autoFarm = true
    elseif not AutoFarm.Running and LP10UI.toggles.autoFarm then
        autoFarmSet(false, false)
        LP10UI.toggles.autoFarm = false
    end
end

