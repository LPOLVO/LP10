    box.ClearTextOnFocus = false
    box.Parent = parent
    Instance.new("UICorner", box).CornerRadius = UDim.new(0, 6)
    options[name].SetValue = function(self, nextValue)
        local value = math.clamp(tonumber(nextValue) or default, minValue, maxValue)
        self.Value = value
        box.Text = tostring(value)
        if callback then callback(value) end
    end
    box.FocusLost:Connect(function()
        options[name]:SetValue(box.Text)
    end)
    return box
end

