local function AutomationLabel(text, height, color)
    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, -4, 0, height or 28)
    label.BackgroundTransparency = 1
    label.Font = Enum.Font.Gotham
    label.Text = text
    label.TextColor3 = color or Color3.fromRGB(235, 235, 235)
    label.TextSize = 13
    label.TextWrapped = true
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.TextYAlignment = Enum.TextYAlignment.Center
    label.Parent = AutomationPanel
    return label
end

local function AutomationToggle(text, default, callback)
    local button = Instance.new("TextButton")
    button.Size = UDim2.new(1, -4, 0, 30)
    button.BackgroundColor3 = Color3.fromRGB(25, 25, 25)
    button.AutoButtonColor = false
    button.Font = Enum.Font.GothamBold
    button.TextColor3 = Color3.fromRGB(245, 245, 245)
    button.TextSize = 13
    button.TextXAlignment = Enum.TextXAlignment.Left
    button.Parent = AutomationPanel
    Instance.new("UICorner", button).CornerRadius = UDim.new(0, 6)

    local state = default == true
    local function render()
        button.Text = "  " .. text .. "    [" .. (state and "ON" or "OFF") .. "]"
        button.BackgroundColor3 = state and Color3.fromRGB(20, 92, 145) or Color3.fromRGB(25, 25, 25)
    end
    button.MouseButton1Click:Connect(function()
        state = not state
        render()
        callback(state)
    end)
    render()
    return button
end

local function AutomationNumber(text, default, minValue, maxValue, callback)
    local box = Instance.new("TextBox")
    box.Size = UDim2.new(1, -4, 0, 30)
    box.BackgroundColor3 = Color3.fromRGB(25, 25, 25)
    box.Font = Enum.Font.Gotham
    box.PlaceholderText = text
    box.Text = tostring(default)
    box.TextColor3 = Color3.fromRGB(245, 245, 245)
    box.TextSize = 13
    box.ClearTextOnFocus = false
    box.Parent = AutomationPanel
    Instance.new("UICorner", box).CornerRadius = UDim.new(0, 6)
    box.FocusLost:Connect(function()
        local value = tonumber(box.Text) or default
        value = math.clamp(value, minValue, maxValue)
        box.Text = tostring(value)
        callback(value)
    end)
    return box
end

