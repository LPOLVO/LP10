        Play(cardStroke, 0.14, {Transparency = 0.55}):Play()
    end)
    Run.MouseButton1Click:Connect(function()
        if type(data.S) ~= "string" or data.S == "" then
            Run.Text = "EMPTY"
            task.delay(0.9, function()
                if Run and Run.Parent then Run.Text = "RUN" end
            end)
            return
        end

        Run.Text = "LOAD"
        task.spawn(function()
            local ok, err = pcall(function()
                local fn, compileError = loadstring(data.S)
                if type(fn) ~= "function" then
                    error(compileError or "loadstring returned no function")
                end
                fn()
            end)
            if Run and Run.Parent then
                Run.Text = ok and "DONE" or "ERROR"
                task.delay(1.1, function()
                    if Run and Run.Parent then Run.Text = "RUN" end
                end)
            end
            if not ok then warn("[LP10] "..tostring(err)) end
        end)
    end)
end

