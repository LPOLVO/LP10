function Automation:GetSafeCFrame(prompt)
    local finalDoor = AutomationGetFinalDoor()
    local customsBuilding = finalDoor and finalDoor:FindFirstAncestor("CustomsBuilding")
    local holder = prompt and prompt.Parent
    local promptPos = holder and holder:IsA("Attachment") and holder.WorldPosition
        or holder and holder:IsA("BasePart") and holder.Position
    if not promptPos then return end

    local bestFloor, bestDist = nil, math.huge
    if customsBuilding then
        for _, office in ipairs(customsBuilding:GetChildren()) do
            if office.Name == "CustomsOffice" then
                local floor = office:FindFirstChild("Floor", true)
                if floor and floor:IsA("BasePart") then
                    local d = (floor.Position - promptPos).Magnitude
                    if d < bestDist then bestFloor, bestDist = floor, d end
                end
            end
        end
    end
    if not bestFloor then return end

    local position = bestFloor.CFrame:PointToWorldSpace(Vector3.new(5, bestFloor.Size.Y * 0.5 + 3.25, 8))
    return CFrame.lookAt(position, Vector3.new(promptPos.X, position.Y, promptPos.Z), Vector3.yAxis)
end

function Automation:MoveToSafe(prompt, token)
    if not self.SafeGateWait then
        AutomationReleaseSafe()
        return true
    end
    local dest = self:GetSafeCFrame(prompt)
    local root = AutomationRoot()
    if not dest or not root then
        return false, "Safe position is unavailable"
    end
    AutomationReleaseSafe()
    self.SafeCharacter = AutomationPlayer.Character
    self.SafeRootWasAnchored = root.Anchored
    self.SafeCFrame = dest

    if not AutomationMove(dest, true) then
        AutomationReleaseSafe()
        return false, "Could not enter safe zone"
    end
    self:SetPhase("Safe Gate Wait", "Waiting in a safe spot")
    return true
end

function Automation:MaintainSafe(token)
    if not self.SafeGateWait then
        AutomationReleaseSafe()
        return true
    end
    if not self.SafeCFrame then
        return self:MoveToSafe(AutomationPrompt(), token)
    end
    local char = AutomationPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if char ~= self.SafeCharacter or not root then
        return self:MoveToSafe(AutomationPrompt(), token)
    end
    root.CFrame = self.SafeCFrame
    root.AssemblyLinearVelocity = Vector3.zero
    root.AssemblyAngularVelocity = Vector3.zero
    root.Anchored = true
    return true
end

-- ============================================================================
-- Gate Activation
-- ============================================================================
function Automation:ActivateGate(prompt, token)
    if not prompt then
        return false, "End gate prompt was not found"
    end
    local position = AutomationPromptPosition(prompt)
    local root = AutomationRoot()
    if position and root then
        local dir = root.Position.Z <= position.Z and 1 or -1
        AutomationMove(CFrame.lookAt(position - Vector3.new(0, 0, dir * 6), position, Vector3.yAxis))
        task.wait(0.3)
    end

    self:SetPhase("Activating Gate", "Starting the countdown")

    for attempt = 1, 3 do
        if self.Token ~= token or not self.Running then
            return false, "Automation stopped"
        end
        local before = AutomationGateSeconds(prompt)
        if AutomationFirePrompt(prompt) then
            local expires = os.clock() + 6
            repeat
                local current = AutomationGateSeconds(prompt)
                local accepted = (not prompt.Enabled)
                    or (current and before and current < before)
                    or (current and current < 120)
                if accepted then
                    -- نستخدم os.clock() دائماً
                    self.GateStartedAt = os.clock() - math.max(0, 120 - (current or 120))
                    self.GateActivations += 1
                    return true
                end
                task.wait(0.25)
            until os.clock() >= expires or not self.Running or self.Token ~= token
        end
        self.Retries += 1
        task.wait(attempt)
    end
    return false, "Gate activation was not confirmed"
end

-- ============================================================================
-- WaitForGate — إصلاح جوهري
-- ============================================================================
function Automation:WaitForGate(prompt, token)
    local expires = os.clock() + self.GateTimeout
    self:SetPhase("Waiting for Gate", "Waiting for the two minute countdown")

    local safeOK, safeErr = self:MoveToSafe(prompt, token)
    if not safeOK then
        AutomationNotify(safeErr)
    end

    local opened = false
    repeat
        if self.Token ~= token or not self.Running then
            AutomationReleaseSafe()
            return false, "Automation stopped"
        end

        -- شاشة النهاية
        local endFrame = AutomationEndScreen()
        if endFrame then
            AutomationReleaseSafe()
            return false, "EndScreen"
        end

        -- الحفاظ على الوضع الآمن
        if self.SafeGateWait then
            self:MaintainSafe(token)
        end

        local secs, text = AutomationGateSeconds(prompt)
        if text then self.GateText = text end
        self:UpdateUI()

        local elapsed = self.GateStartedAt > 0 and (os.clock() - self.GateStartedAt) or 0

        -- البوابة فُتحت
        if (secs and secs <= 0)
            or (self.GateStartedAt > 0 and elapsed >= 120)
            or (prompt and not prompt.Enabled)
        then
            opened = true
            break
        end

        task.wait(0.5)
    until os.clock() >= expires

    AutomationReleaseSafe()

    if not opened then
        return false, "Gate wait timed out"
    end
    return true
end

-- ============================================================================
-- CrossGate — إصلاح الاتجاه والتحقق
-- ============================================================================
function Automation:CrossGate(prompt, token)
    local position = AutomationPromptPosition(prompt)
    local root = AutomationRoot()
    if not position or not root then
        return false, "Gate position is unavailable"
    end

    local endZ = AutomationGetEndZ() or position.Z
    local start = workspace:FindFirstChildOfClass("SpawnLocation")
    local direction = (not start or endZ >= start.Position.Z) and 1 or -1

    self:SetPhase("Entering Finish", "Crossing the opened gate")

    -- نقاط عبور تدريجية
    local offsets = { 6, 16, 30, 50, 75, 100, 140 }
    for _, offset in ipairs(offsets) do
        if self.Token ~= token or not self.Running then
            return false, "Automation stopped"
        end

        local target = Vector3.new(position.X, position.Y + 3, position.Z + direction * offset)
        AutomationMove(CFrame.lookAt(target, target + Vector3.new(0, 0, direction), Vector3.yAxis))
        task.wait(0.35)

        if (target.Z - endZ) * direction >= 0 then
            self.FinishCrossed = true
            self:Persist()
        end

        local es = AutomationEndScreen()
        if es then
            return true, "EndScreen"
        end
    end

    -- محاولة إضافية عبر MoveTo
    local hum = AutomationHumanoid()
    if hum then
        hum:MoveTo(position + Vector3.new(0, 0, direction * 130))
    end

    local waitExpires = os.clock() + 35
    repeat
        if self.Token ~= token or not self.Running then
            return false, "Automation stopped"
        end
        if AutomationEndScreen() then return true, "EndScreen" end
        task.wait(0.25)
    until os.clock() >= waitExpires

    return false, "Finish result did not appear"
end

-- ============================================================================
-- Replay / Lobby — يجب تجهيز الطابور قبل الضغط
-- ============================================================================
function Automation:ReplayOrLobby(token)
    local endFrame, outcome = AutomationEndScreen()
    if not endFrame then
        return false, "Result screen was not found"
    end

    if self.AutoReplay then
        -- 1) جهّز الطابور أولاً قبل أي إجراء
        if not self:QueueForTeleport(self.GamePlaceId) then
            return false, self.LastError or "Replay queue failed"
        end

        self:SetPhase("Auto Replay", "Submitting replay vote")
        self.Replays += 1

        -- 2) جرّب FlowClient.Replay أولاً
        if AutomationFlow and AutomationFlow.GameManager
            and type(AutomationFlow.GameManager.Replay) == "function"
        then
            local ok = pcall(AutomationFlow.GameManager.Replay)
            if ok then
                return true, "ReplayQueued"
            end
        end

        -- 3) جرّب زر Replay
        for _, button in ipairs(endFrame:GetDescendants()) do
            if button:IsA("GuiButton") and AutomationVisible(button) then
                local name = button.Name:lower()
                local text = button:IsA("TextButton") and tostring(button.Text or ""):lower() or ""
                if text == "" then
                    local lbl = button:FindFirstChildWhichIsA("TextLabel", true)
                    text = lbl and tostring(lbl.Text or ""):lower() or ""
                end
                if name:find("replay", 1, true) or text:find("replay", 1, true) then
                    local clicked = type(firesignal) == "function"
                        and pcall(firesignal, button.MouseButton1Click)
                        or pcall(button.Activate, button)
                    if clicked then
                        return true, "ReplayClicked"
                    end
                end
            end
        end
        -- إن فشل Replay → رجوع للوبي
    end

    -- رجوع للوبي
    if not self:QueueForTeleport(self.LobbyPlaceId) then
        return false, self.LastError or "Lobby queue failed"
    end
    self:SetPhase("Returning to Lobby", "Preparing to return")
    if AutomationFlow and AutomationFlow.GameManager
        and type(AutomationFlow.GameManager.BackToLobby) == "function"
    then
        return pcall(AutomationFlow.GameManager.BackToLobby)
    end
    return false, "Lobby controls are unavailable"
end

-- ============================================================================
-- RunGame — الإصلاح الرئيسي: جهّز الطابور قبل CrossGate
-- ============================================================================
function Automation:RunGame(token)
    -- معالجة Run معلّق من جلسة سابقة
    if self.PendingFinish and self.LastGameJob ~= "" and self.LastGameJob ~= game.JobId then
        self.Completed += 1
        self.PendingFinish = false
        self.FinishCrossed = false
        self.PendingAt = 0
    end

    -- إذا كانت شاشة النهاية ظاهرة فوراً
    local es = AutomationEndScreen()
    if es then
        return self:ReplayOrLobby(token)
    end

    if self.LastGameJob ~= game.JobId then
        self.LastGameJob = game.JobId
        self.RunStartedAt = os.time()
        self.Attempts += 1
        self.GateStartedAt = 0
        self.FinishCrossed = false
        self.PendingFinish = false
        self.PendingAt = 0
        self:Persist()
    end

    self:SetPhase("Loading Game", "Waiting for the map")
    local expires = os.clock() + 30
    repeat
        local hum = AutomationHumanoid()
        local root = AutomationRoot()
        if hum and root and hum.Health > 0 and workspace:FindFirstChild("Map") then
            break
        end
        task.wait(0.25)
    until os.clock() >= expires or not self.Running or self.Token ~= token

    if not self.Running or self.Token ~= token then
        return true, "Stopped"
    end

    -- انتظر ظهور البوابة
    self:SetPhase("Traveling", "Locating end gate")
    local prompt, promptExpires = nil, os.clock() + 20
    repeat
        prompt = AutomationPrompt()
        if not prompt then task.wait(0.25) end
    until prompt or os.clock() >= promptExpires or not self.Running or self.Token ~= token

    if not prompt then
        self.Failed += 1
        return false, "End gate prompt was not found"
    end

    -- تفعيل البوابة
    local activated, activationError = self:ActivateGate(prompt, token)
    if not activated then
        self.Failed += 1
        return false, activationError
    end

    -- انتظار الفتح
    local opened, gateError = self:WaitForGate(prompt, token)
    if not opened then
        if gateError == "EndScreen" then
            return self:ReplayOrLobby(token)
        end
        self.Failed += 1
        return false, gateError
    end

    -- ★ مهم: جهّز الطابور قبل اجتياز البوابة
    local nextPlace = self.AutoReplay and self.GamePlaceId or self.LobbyPlaceId
    if not self:QueueForTeleport(nextPlace) then
        self.Failed += 1
        return false, self.LastError or "Could not queue next teleport"
    end

    self.PendingFinish = true
    self.PendingAt = os.time()
    self:Persist()

    -- اجتياز البوابة
    local crossed, crossError = self:CrossGate(prompt, token)
    if not crossed then
        self.PendingFinish = false
        self.Failed += 1
        return false, crossError
    end

    -- وصلنا لشاشة النهاية
    self.Completed += 1
    self.RunStartedAt = 0
    self.GateText = "--"
    self.PendingFinish = false
    self.FinishCrossed = false
    self.PendingAt = 0

    return self:ReplayOrLobby(token)
end

function Automation:RunLobby(token)
    self:SetPhase("Lobby", "Waiting before the next run")
    task.wait(self.LobbyDelay)
    if self.Token ~= token or not self.Running then return true end

    if not AutomationFlow or not AutomationFlow.LobbyServer then
        return false, "Lobby API is unavailable"
    end
    local lobby = AutomationFlow.LobbyServer

    local playerGui = AutomationPlayer:FindFirstChildOfClass("PlayerGui")
    local createGui = playerGui and (playerGui:FindFirstChild("CreateLobbyGui")
        or playerGui:WaitForChild("CreateLobbyGui", 10))
    if not createGui then
        return false, "Create lobby UI is unavailable"
    end

    local car = AutomationOwnedCar()
    if not car then return false, "No owned vehicle available" end

    if type(lobby.play) == "function" then pcall(lobby.play) end

    local createFrame = createGui:FindFirstChild("Frame")
    local exitFrame = createGui:FindFirstChild("Exit")
    local waitExpires = os.clock() + 10
    repeat
        createFrame = createGui:FindFirstChild("Frame")
        exitFrame = createGui:FindFirstChild("Exit")
        if exitFrame and exitFrame.Visible then
            pcall(lobby.exit)
            task.wait(0.5)
        end
        task.wait(0.2)
    until (createFrame and createFrame.Visible)
        or os.clock() >= waitExpires
        or not self.Running or self.Token ~= token

    if not createFrame or not createFrame.Visible then
        return false, "Lobby create frame did not appear"
    end
    if type(lobby.create) ~= "function" then
        return false, "Lobby create is unavailable"
    end

    -- جهّز الطابور قبل الإنشاء
    if not self:QueueForTeleport(self.GamePlaceId) then
        return false, self.LastError or "Game queue failed"
    end

    self:SetPhase("Creating Game", "Vehicle: "..car)
    createFrame.Visible = false
    local ok, err = pcall(lobby.create, {
        maxPlayers = 1,
        permissions = "Friends",
        car = car,
    })
    if not ok then
        return false, tostring(err)
    end
    return true, "Creating"
end

function Automation:Start()
    if self.Running then return end
    if not AutomationFlow then
        self.LastError = "FlowClient is unavailable"
        self:SetPhase("Start Failed", self.LastError)
        AutomationNotify(self.LastError)
        return
    end

    self.Running = true
    self.Token = {}
    self.StartedAt = os.time()
    self.Attempts = 0
    self.Completed = 0
    self.Failed = 0
    self.Retries = 0
    self.GateActivations = 0
    self.NPCRequests = 0
    self.Replays = 0
    self.PendingFinish = false
    self.FinishCrossed = false
    self.PendingAt = 0
    self.LastGameJob = ""
    self:SetPhase("Starting", "Automation enabled")
    self:Persist()

    task.spawn(function()
        local token = self.Token
        while self.Running and self.Token == token do
            local ctx = self:GetContext()
            local ok, result, detail = xpcall(function()
                if ctx == "Lobby" then return self:RunLobby(token) end
                if ctx == "Game" then return self:RunGame(token) end
                return false, "Unsupported place: "..tostring(game.PlaceId)
            end, function(m)
                if debug and type(debug.traceback) == "function" then
                    return debug.traceback(tostring(m), 2)
                end
                return tostring(m)
            end)
            if not ok then result, detail = false, tostring(result) end

            if self.Token ~= token or not self.Running then break end

            -- انتظر قليلاً لتفعيل الـ Teleport
            if result == true and (detail == "ReplayQueued"
                or detail == "ReplayClicked"
                or detail == "Creating"
                or detail == "EndScreen")
            then
                task.wait(2)
            end

            if not result and self.Running and self.Token == token then
                self.Retries += 1
                self.LastError = tostring(detail or "Automation failed")
                self:SetPhase("Retrying", self.LastError)
                self:Persist()
                task.wait(math.max(3, self.RetryDelay))
            elseif self.Running and self.Token == token then
                task.wait(1)
            end
        end
    end)

    task.spawn(function()
        local token = self.Token
        while self.Running and self.Token == token do
            if self:GetContext() == "Game" then
                self.NPCRequests += AutomationDamageNPCs()
            end
            self:UpdateUI()
            task.wait(0.5)
        end
    end)
end

function Automation:Stop()
    self.Running = false
    self.Token = nil
    AutomationReleaseSafe()
    self:SetPhase("Stopped", "Automation is disabled")
    pcall(function()
        local ts = game:GetService("TeleportService")
        ts:SetTeleportSetting(self.EnabledKey, false)
        ts:SetTeleportSetting(self.TransitionKey, "")
    end)
    self:Persist()
end

