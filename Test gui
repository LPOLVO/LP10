function AutoFarm:GetTeleportLoader()
    -- Try the injected source first, then fall back to the object field
    local fromEnv = env and env.LP10RunawaysAutomationSource
    if type(fromEnv) == "string" and fromEnv ~= "" then
        return fromEnv:match("^%s*(.-)%s*$") or fromEnv
    end
    return tostring(self.TeleportLoader or ""):match("^%s*(.-)%s*$") or ""
end

function AutoFarm:HasTeleportLoader()
    local loader = self:GetTeleportLoader()
    if loader == "" then return false end
    -- Accept if it has at least one actual code line (not only comments)
    for line in loader:gmatch("[^\n]+") do
        local trimmed = line:match("^%s*(.-)%s*$")
        if trimmed ~= "" and not trimmed:match("^%-%-") then
            return true
        end
    end
    return false
end

