local function AutomationGateSeconds(prompt)
    local finalDoor = prompt and prompt:FindFirstAncestor("FinalDoor") or AutomationGetFinalDoor()
    if not finalDoor then return end
    for _, label in ipairs(finalDoor:GetDescendants()) do
        if label:IsA("TextLabel") and AutomationVisible(label) then
            local m, s = label.Text:match("(%d+)%s*m%s*(%d+)%s*s")
            if not m then m, s = label.Text:match("(%d+)%s*:%s*(%d+)") end
            if m and s then return tonumber(m) * 60 + tonumber(s), label.Text end
        end
    end
end

