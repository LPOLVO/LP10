local function listForPage(page)
    local result = {}
    if page == "Favorites" then
        for _, n in ipairs(Persist.favorites) do
            for _, d in ipairs(Scripts) do if d.N == n then table.insert(result,d) end end
        end
    elseif page == "Pinned" then
        for _, n in ipairs(Persist.pinned) do
            for _, d in ipairs(Scripts) do if d.N == n then table.insert(result,d) end end
        end
    elseif page == "Recent" then
        for _, n in ipairs(Persist.recent) do
            for _, d in ipairs(Scripts) do if d.N == n then table.insert(result,d) end end
        end
    else
        result = Scripts
    end
    return result
end

local function buildLibrary(page)
    local titles = {Scripts="Script Library", Favorites="Favorites", Pinned="Pinned Scripts", Recent="Recently Executed"}
    PageTitle.Text = titles[page] or "Script Library"
    PageSub.Text   = page=="Scripts" and "Tap a script to inspect it before executing." or "Your curated LP10 collection."

    local list  = listForPage(page)
    local query = (SearchBox.Text or ""):lower()
    local visible = 0

    for _, data in ipairs(list) do
        local catMatch = ActiveCat == "All"
            or (ActiveCat == "New" and data.New)
            or (data.Cat == ActiveCat)
        local searchMatch = query == "" or data.N:lower():find(query, 1, true)
        if catMatch and searchMatch then
            visible = visible + 1
            scriptCard(Body, data, visible)
        end
    end

    if visible == 0 then
        label(Body, {
            Size=UDim2.new(1,0,0,110), LayoutOrder=1,
            Text=query~="" and ('No matches for "'..SearchBox.Text..'"') or
                 "Nothing here yet.\nExecute scripts to fill this collection.",
            TextColor3=C.muted, Font=Enum.Font.GothamSemibold, TextSize=13,
            TextWrapped=true, TextXAlignment=Enum.TextXAlignment.Center, ZIndex=16,
        })
    end
end

