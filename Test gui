local function makeToggleControl(parent, name, text, default, callback)
    local button = makeButton(parent, "", 28)
    local value = default == true
    local function render()
        button.Text = "  " .. text .. "    [" .. (value and "ON" or "OFF") .. "]"
        button.BackgroundColor3 = value and Color3.fromRGB(20, 92, 145) or Color3.fromRGB(25, 25, 25)
    end
    toggles[name].SetValue = function(self, nextValue)
        value = nextValue == true
        self.Value = value
        render()
        if callback then callback(value) end
    end
    toggles[name].Value = value
    button.MouseButton1Click:Connect(function()
        toggles[name]:SetValue(not value)
    end)
    render()
    return button
end

