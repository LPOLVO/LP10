function Automation:QueueForTeleport(targetPlaceId)
    local queue = self:GetQueueFunction()
    if not queue then
        self.LastError = "queue_on_teleport is unavailable"
        self:SetPhase("Queue Failed", self.LastError)
        return false
    end
    local loader = tostring(
        AutomationEnv.LP10RunawaysTeleportLoader
        or AutomationEnv.LP10RunawaysAutomationSource
        or ""
    ):match("^%s*(.-)%s*$")

    if loader == "" then
        self.LastError = "Teleport loader is empty"
        return false
    end

    -- Token فريد للانتقال
    local token = table.concat({
        tostring(AutomationPlayer.UserId),
        game.JobId,
        tostring(targetPlaceId),
        tostring(os.time()),
        tostring(math.random(100000, 999999)),
    }, ":")
    self.TransitionToken = token

    if not self:Persist() then
        self.LastError = "Could not persist transition state"
        return false
    end

    local snapshot = nil
    pcall(function()
        snapshot = game:GetService("HttpService"):JSONEncode(self:GetSnapshot())
    end)

    local payload = string.format(
        "if not game:IsLoaded() then game.Loaded:Wait() end\n"
        .. "if game.PlaceId == %d or game.PlaceId == %d then\n"
        .. "local PL = game:GetService('Players')\n"
        .. "while not PL.LocalPlayer do task.wait() end\n"
        .. "local e = (getgenv and getgenv() or _G)\n"
        .. "e.LP10RunawaysQueuedState = %q\n"
        .. "e.LP10RunawaysTransitionToken = %q\n"
        .. "%s\n"
        .. "end",
        self.LobbyPlaceId, self.GamePlaceId,
        snapshot or "", token, loader
    )

    local ok, err = pcall(queue, payload)
    if not ok then
        self.LastError = "Queue failed: "..tostring(err)
        self:SetPhase("Queue Failed", self.LastError)
        return false
    end
    self.QueueJob = game.JobId
    return true
end

