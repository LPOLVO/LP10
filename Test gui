function Automation:UpdateUI()
    local elapsed = self.StartedAt > 0 and os.time() - self.StartedAt or 0
    local runElapsed = self.RunStartedAt > 0 and os.time() - self.RunStartedAt or 0
    local function dur(v)
        v = math.max(0, math.floor(tonumber(v) or 0))
        return string.format("%02d:%02d:%02d", math.floor(v/3600), math.floor(v%3600/60), v%60)
    end
    if self.Controls.Status then
        self.Controls.Status.Text = "Status: "..self.Phase.."\n"..self.Detail
    end
    if self.Controls.Stats then
        self.Controls.Stats.Text = string.format(
            "Session: %s | Runs: %d/%d\nFailures: %d | Retries: %d | NPC: %d\nCurrent run: %s | Gate: %s",
            dur(elapsed), self.Completed, self.Attempts, self.Failed, self.Retries,
            self.NPCRequests, dur(runElapsed), self.GateText or "--"
        )
    end
    if self.Controls.Error then
        self.Controls.Error.Text = "Last error: "..tostring(self.LastError)
    end
end

