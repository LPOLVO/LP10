local function AutomationDamageNPCs()
    local folder = workspace:FindFirstChild("NPCs")
    local root = AutomationRoot()
    local npcApi = AutomationFlow and AutomationFlow.NPCs
    local total = 0
    if not folder or not root or not npcApi or type(npcApi.Damage) ~= "function" then
        return 0
    end
    for _, humanoid in ipairs(folder:GetDescendants()) do
        if humanoid:IsA("Humanoid") and humanoid.Health > 0 then
            local npc = humanoid:FindFirstAncestorOfClass("Model")
            local npcRoot = npc and npc:FindFirstChild("HumanoidRootPart")
            if npcRoot and (npcRoot.Position - root.Position).Magnitude <= 80 then
                if pcall(npcApi.Damage, humanoid, humanoid.Health + 1) then
                    total += 1
                end
            end
        end
    end
    return total
end

local function AutomationOwnedCar()
    local playerData = AutomationFlow and AutomationFlow.PlayerDataClient
