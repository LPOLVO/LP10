        button.Text = "  "..text.."    ["..(state and "ON" or "OFF").."]"
        button.BackgroundColor3 = state and Color3.fromRGB(20, 92, 145) or Color3.fromRGB(25, 25, 25)
    end
    local function setState(next, fire)
        state = next == true
        render()
        if fire and callback then callback(state) end
    end
    Automation.ToggleSetters[key] = setState
    button.MouseButton1Click:Connect(function() setState(not state, true) end)
    render()
    return button
