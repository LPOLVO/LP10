function Automation:Persist()
    local http = game:GetService("HttpService")
    local ok, encoded = pcall(http.JSONEncode, http, self:GetSnapshot())
    if not ok then return false end
    pcall(function()
        local ts = game:GetService("TeleportService")
        ts:SetTeleportSetting(self.StateKey, encoded)
        ts:SetTeleportSetting(self.EnabledKey, self.Running == true)
        ts:SetTeleportSetting(self.TransitionKey, self.TransitionToken or "")
    end)
    if type(writefile) == "function" then
        pcall(function()
            if type(isfolder) ~= "function" or not isfolder("MyScriptHub") then
                if type(makefolder) == "function" then makefolder("MyScriptHub") end
            end
            if type(isfolder) ~= "function" or not isfolder("MyScriptHub/RUNAWAYS") then
                if type(makefolder) == "function" then makefolder("MyScriptHub/RUNAWAYS") end
            end
            writefile(self.StatePath, encoded)
        end)
    end
    return true
end

function Automation:GetSnapshot()
    return {
        Version = 1,
        UpdatedAt = os.time(),
        Enabled = self.Running == true,
        SafeGateWait = self.SafeGateWait == true,
        AutoReplay = self.AutoReplay == true,
        LobbyDelay = self.LobbyDelay,
        GateTimeout = self.GateTimeout,
        RetryDelay = self.RetryDelay,
        StartedAt = self.StartedAt,
        Attempts = self.Attempts,
        Completed = self.Completed,
        Failed = self.Failed,
        Retries = self.Retries,
        GateActivations = self.GateActivations,
        NPCRequests = self.NPCRequests,
        Replays = self.Replays,
        TransitionToken = self.TransitionToken,
    }
end

function Automation:LoadState()
    local http = game:GetService("HttpService")
    local candidates = {}
    pcall(function()
        local v = game:GetService("TeleportService"):GetTeleportSetting(self.StateKey)
        if type(v) == "string" then candidates[#candidates+1] = v end
    end)
    if type(readfile) == "function" and type(isfile) == "function" then
        pcall(function()
            if isfile(self.StatePath) then candidates[#candidates+1] = readfile(self.StatePath) end
        end)
    end
    for _, enc in ipairs(candidates) do
        local ok, state = pcall(http.JSONDecode, http, enc)
        if ok and type(state) == "table" then
            self.LoadedState = state
            break
        end
    end
end

function Automation:ApplyLoadedState()
    local s = self.LoadedState
    if type(s) ~= "table" then
        self.StateReady = true
        self:Persist()
        return
    end
    self.SafeGateWait = s.SafeGateWait ~= false
    self.AutoReplay = s.AutoReplay ~= false
    self.LobbyDelay = math.clamp(tonumber(s.LobbyDelay) or 3, 0, 30)
    self.GateTimeout = math.clamp(tonumber(s.GateTimeout) or 165, 125, 240)
    self.RetryDelay = math.clamp(tonumber(s.RetryDelay) or 10, 3, 30)
    self.StateReady = true

    if self.NumberSetters.LobbyDelay then self.NumberSetters.LobbyDelay(self.LobbyDelay, false) end
    if self.NumberSetters.GateTimeout then self.NumberSetters.GateTimeout(self.GateTimeout, false) end
    if self.NumberSetters.RetryDelay then self.NumberSetters.RetryDelay(self.RetryDelay, false) end
    if self.ToggleSetters.SafeGateWait then self.ToggleSetters.SafeGateWait(self.SafeGateWait, false) end
    if self.ToggleSetters.AutoReplay then self.ToggleSetters.AutoReplay(self.AutoReplay, false) end
    self:UpdateUI()

    if s.Enabled == true and os.time() - (tonumber(s.UpdatedAt) or 0) <= 900 then
        task.defer(function()
            if self.ToggleSetters.AutoFarm then self.ToggleSetters.AutoFarm(true, true) end
        end)
    else
        self:Persist()
    end
end

